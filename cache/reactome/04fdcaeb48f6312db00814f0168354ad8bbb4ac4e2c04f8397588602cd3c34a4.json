3-25", "speciesName": "Rattus norvegicus", "inferredFrom": [5672980], "species": [{"dbId": 48895, "displayName": "Rattus norvegicus", "name": ["Rattus norvegicus", "R. norvegicus", "Rn", "brown rat", "Norway rat"], "taxId": "10116", "abbreviation": "RNO", "className": "Species", "schemaClass": "Species"}], "category": "dissociation", "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10059722, "displayName": "Dissociation of RAS:RAF complex", "stId": "R-MMU-5672980", "stIdVersion": "R-MMU-5672980.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["Dissociation of RAS:RAF complex"], "releaseDate": "2026-03-25", "speciesName": "Mus musculus", "inferredFrom": [5672980], "species": [{"dbId": 48892, "displayName": "Mus musculus", "name": ["Mus musculus", "M. musculus", "Mm", "house mouse"], "taxId": "10090", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "category": "dissociation", "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 5690572, "displayName": "Roskoski, Robert Jr, 2015-04-28", "dateTime": "2015-04-29 00:20:02", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 5675211, "displayName": "The mechanisms governing the dissociation or trafficking of ...", "text": "The mechanisms governing the dissociation or trafficking of activated MAPK signaling complexes at the plasma membrane are not fully worked out. Some active complexes may be endocytosed and targeted to other cellular locations, for example the Golgi complex (Lorentzen et al, 2010). Activated RAF monomers may dissociate and homo- or heterodimerize with additional inactive RAF monomers and in this way amplify the signal (reviewed in Matallanas et al, 2011; Cseh et al, 2014).<br>Ultimately, active RAF complexes are subject to PP5- and PP2A-mediated dephosphorylation, which promotes a return to the inactive state. Hydrolysis of RAS-bound GTP by the intrinsic GTPase activity, stimulated by association with RAS GAP proteins, ultimately promotes dissociation of RAS from RAF allowing a return to the quiescent state (reviewed in Wellbrock et al, 2004; Matallanas et al, 2011).", "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "deleted": [{"dbId": 6799080, "displayName": "Deletion of instance: 1268206", "replacementInstances": [5672980], "deletedInstanceDbId": [1268206], "className": "Deleted", "schemaClass": "Deleted"}], "updateTrackers": [{"dbId": 9782907, "displayName": "Update Tracker - [Reaction:5672980] Dissociation of RAS:RAF complex - v58:[modifyText]", "action": ["modifyText"], "updatedInstance": [5672980], "className": "UpdateTracker", "schemaClass": "UpdateTracker"}], "isChimeric": false, "category": "dissociation", "input": [{"dbId": 5672724, "displayName": "activated RAF:scaffold:p-2S MAP2K:p-2T MAPK complex [plasma membrane]", "stId": "R-HSA-5672724", "stIdVersion": "R-HSA-5672724.1", "maxDepth": 11, "name": ["activated RAF:scaffold:p-2S MAP2K:p-2T MAPK complex"], "speciesName": "Homo sapiens", "consumedByEvent": [5672980], "isChimeric": false, "species": [48887], "inDisease": false, "schemaClass": "Complex", "className": "Complex"}], "output": [{"dbId": 5672712, "displayName": "p21RAS:GTP:activated RAF homo/heterodimers [plasma membrane]", "stId": "R-HSA-5672712", "stIdVersion": "R-HSA-5672712.1", "maxDepth": 4, "name": ["p21RAS:GTP:activated RAF homo/heterodimers"], "speciesName": "Homo sapiens", "producedByEvent": [5672980], "isChimeric": false, "species": [48887], "inDisease": false, "schemaClass": "Complex", "className": "Complex"}, {"dbId": 5672717, "displayName": "RAF/MAPK scaffolds [cytosol]", "stId": "R-HSA-5672717", "stIdVersion": "R-HSA-5672717.2", "maxDepth": 10, "name": ["RAF/MAPK scaffolds"], "speciesName": "Homo sapiens", "