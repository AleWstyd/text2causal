", "house mouse"], "taxId": "10090", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 3139040, "displayName": "Roncagalli, Romain, 2013-02-13", "dateTime": "2013-02-13 21:56:18", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 2685542, "displayName": "Raft localized PKC-theta is phosphorylated and is activated....", "text": "Raft localized PKC-theta is phosphorylated and is activated. Phosphorylation of both tyrosine and serine-threonine residues is important in the regulation of PKC function. Six phosphorylation sites have been identified on PKC-theta: Y90, T219, T538, S676, S685, and S695. Phosphorylation of Y90 positively regulates NF-AT and NF-kB activation in T-cells. In mast cells Src family members Src and LYN have been shown to be involved in phosphorylating Y90 (Wang et al. 2012, Liu et al. 2001).", "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "category": "transition", "catalystActivity": [{"dbId": 2730854, "displayName": "protein tyrosine kinase activity of Allergen:p-LYN:p-FCERI:IgE aggregate [plasma membrane]", "catalyzedEvent": [2730882], "physicalEntity": {"dbId": 2454232, "displayName": "Allergen:p-LYN:p-FCERI:IgE aggregate [plasma membrane]", "stId": "R-HSA-2454232", "stIdVersion": "R-HSA-2454232.2", "maxDepth": 7, "name": ["Allergen:p-LYN:p-FCERI:IgE aggregate"], "speciesName": "Homo sapiens", "catalystActivities": [2730854], "isChimeric": false, "inDisease": false, "schemaClass": "Complex", "className": "Complex"}, "className": "CatalystActivity", "schemaClass": "CatalystActivity"}], "catalystActivityReference": {"dbId": 9643131, "displayName": "protein tyrosine kinase activ