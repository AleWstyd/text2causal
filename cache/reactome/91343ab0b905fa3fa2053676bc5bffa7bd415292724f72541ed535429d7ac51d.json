transition", "regulatedBy": [{"dbId": 10093697, "displayName": "Positive regulation by 'p-7Y-KIT:sSCF dimer:p-7Y-KIT [plasma membrane]'", "regulatedEntity": [10093824], "schemaClass": "PositiveRegulation", "className": "PositiveRegulation"}], "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 9910860, "displayName": "de la Serna, Ivana L, 2024-05-21", "dateTime": "2024-05-21 17:56:11", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}, {"dbId": 9863245, "displayName": "Arnheiter, Heinz, 2024-02-26", "dateTime": "2024-02-26 21:05:34", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}, {"dbId": 9927252, "displayName": "Steingr\u00edmsson, Eir\u00edkur, 2024-11-05", "dateTime": "2024-11-05 13:46:23", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}, {"dbId": 9927254, "displayName": "Vu, Hong Nhung, 2024-11-05", "dateTime": "2024-11-05 13:47:36", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 9825698, "displayName": "A link between protein translation levels and MITF signaling...", "text": "A link between protein translation levels and MITF signaling is suggested by the role of the Lys tRNA synthetase, KARS (also called LysRS), in regulating MITF transcription factor by modulating the interaction of MITF with its HINT1 repressor protein (reviewed in Goding and Arnheiter, 2019)<br>KARS is part of a cytosolic complex called the multisynthetase complex (MSC) consisting of an additional 8 other amino-acyl tRNA synthetases and three non-enzymatic proteins (Bandyopadhyay and Deutscher, 1971). Upon KIT stimulation in melanoma cells, the KARS component is phosphorylated in a MAPK-dependent fashion at serine 207 (Razin et al, 1999; Yannay-Cohen et al, 2008; Ofir-Birin et al, 2013). This releases the KARS homodimer from the MSC, increasing the rate at which it synthesizes P(1),P(4)-bis(5'-adenosyl) tetraphosphate(4-) (AP4A) and allowing interaction of the KARS homodimer with MITF (Zamecnik et al, 1966; Razin et al, 1999; Carmi-Levy et al, 2008; Yannay-Cohen et al, 2009). AP4A binds to the MITF repressor HINT1 and disrupts the MITF-HINT1 interaction, relieving repression and allowing activation of MITF-dependent targets (Lee et al, 2004; Carmi-Levy et al, 2008; Yannay-Cohen et al, 2008).", "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "previousReviewStatus": {"dbId": 9821383, "displayName": "three stars", "definition": "internally reviewed", "name": ["three stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "isChimeric": false, "category": "transition", "catalystActivity": [{"dbId": 1268259, "displayName": "MAP kinase activity of p-T,Y MAPK dimers [cytosol]", "catalyzedEvent": [9825759], "physicalEntity": {"dbId": 1268261, "displayName": "p-T,Y MAPK dimers [cytosol]", "stId": "R-HSA-1268261", "stIdVersion": "R-HSA-1268261.1", "maxDepth": 3, "name": ["p-T,Y MAPK dimers", "p-ERK dimer"], "speciesName": "Homo sapiens", "catalystActivities": [1268259], "className": "Set", "inDisease": false, "schemaClass": "DefinedSet"}, "className": "CatalystActivity", "schemaClass": "CatalystActivity"}], "input": [{"dbId": 379688, "displayName": "aminoacyl-tRNA synthetase multienzyme complex [cytosol]", "stId": "R-HSA-379688", "stIdVersion": "R-HSA-379688.19", "maxDepth": 3, "name": ["aminoacyl-tRNA synthetase multienzyme complex", "multisynthetase complex"], "speciesName": "Homo sapiens", "catalystActivities": [{"dbId": 379607, "displayName": "aspartate-tRNA ligase activity of aminoacyl-tRNA synthetase multienzyme complex [cytosol]", "physicalEntity": 379688, "className": "CatalystActivity", "schemaClass": "CatalystActivity"}, {"dbId": 379604, "displayName": "proline-tRNA ligase activity of aminoacyl-tRNA synthetase multienzyme complex [