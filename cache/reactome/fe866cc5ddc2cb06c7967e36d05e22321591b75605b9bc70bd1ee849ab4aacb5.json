 422514, "displayName": "Bluestone, JA, Esensten, J, 2009-06-01 18:47:33", "dateTime": "2009-06-01 22:47:33", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 389728, "displayName": "Cot/Tpl 2 is a serine/threonine kinase of the mitogen activa...", "text": "Cot/Tpl 2 is a serine/threonine kinase of the mitogen activated protein kinase kinase kinase (MAP3K) family. Cot is observed as one of the downstream effectors of Akt. Based on in-vitro kinase assays and following overexpression in cell lines its been showed that AKT can phosphorylate Cot under non-physiological conditions. Akt and Cot physically interact through the amino terminus of Cot, and this interaction results in the phosphorylation of Cot on serine 400. Cot was shown to activate the IkB kinase (IKK) complex, possibly acting through NF kB inducing kinase (NIK).", "literatureReference": [389687], "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "updateTrackers": [{"dbId": 9788326, "displayName": "Update Tracker - [Reaction:389756] AKT interacts and phosphorylates Cot - v42:[add_removeOutput, removeInput]", "action": ["add_removeOutput", "removeInput"], "updatedInstance": [389756], "className": "UpdateTracker", "schemaClass": "UpdateTracker"}], "category": "transition", "catalystActivity": [{"dbId": 198368, "displayName": "protein serine/threonine kinase activity of p-T,p-S-AKT [cytosol]", "catalyzedEvent": [389756], "physicalEntity": {"dbId": 202074, "displayName": "p-T,p-S-AKT [cytosol]", "stId": "R-HSA-202074", "stIdVersion": "R-HSA-202074.2", "maxDepth": 2, "name": ["p-T,p-S-AKT", "Active AKT"], "speciesName": "Homo sapiens", "catalystActivities": [198368], "className": "Set", "inDisease": false, "schemaClass": "CandidateSet"}, "className": "CatalystActivity",