"className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 3002845, "displayName": "AURKA (Aurora A kinase) phosphorylates PLK1 on threonine res...", "text": "AURKA (Aurora A kinase) phosphorylates PLK1 on threonine residue T210 that lies in the conserved aurora kinase consensus site (Seki et al. 2008). PLK1 needs to be phosphorylated on T210 to become catalytically active (Jang et al. 2002). BORA, but not other AURKA co-activators, facilitate PLK1 phosphorylation by AURKA (Macurek et al. 2008, Seki et al. 2008).", "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "isChimeric": false, "category": "transition", "catalystActivity": [{"dbId": 3000312, "displayName": "protein serine/threonine kinase activity of Centrosome:p-T288-AURKA:p-S252-BORA:PLK1 [cytosol]", "catalyzedEvent": [3000310], "physicalEntity": {"dbId": 3000313, "displayName": "Centrosome:p-T288-AURKA:p-S252-BORA:PLK1 [cytosol]", "stId": "R-HSA-3000313", "stIdVersion": "R-HSA-3000313.1", "maxDepth": 5, "name": ["Centrosome:p-T288-AURKA:p-S252-BORA:PLK1"], "speciesName": "Homo sapiens", "catalystActivities": [3000312], "consumedByEvent": [3000310], "isChimeric": false, "species": [48887], "inDisease": false, "schemaClass": "Complex", "className": "Complex"}, "className": "CatalystActivity", "schemaClass": "CatalystActivity"}], "catalystActivityReference": {"dbId": 9643682, "displayName": "protein serine/threonine kinase activity of Centrosome:p-T288-AURKA:p-S252-BORA:PLK1 [cytosol] Bora and the kinase Aurora a cooperatively activate the kinase Plk1 and control mitotic entry", "literatureReference": [3000320], "className": "CatalystActivityReference", "schemaClass": "CatalystActivityReference"}, "input": [{"dbId": 113592, "displayName": "ATP [cytosol]", "stId": "R-ALL-113592