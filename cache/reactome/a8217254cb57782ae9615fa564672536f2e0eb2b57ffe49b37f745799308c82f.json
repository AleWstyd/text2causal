-2730863.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["Phosphorylation of CARMA1 by PKC-theta"], "releaseDate": "2026-03-25", "speciesName": "Bos taurus", "inferredFrom": [2730863], "species": [{"dbId": 48898, "displayName": "Bos taurus", "name": ["Bos taurus", "B. taurus", "Bt", "bovine", "cattle", "cow", "domestic cattle", "domestic cow"], "taxId": "9913", "abbreviation": "BTA", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10280678, "displayName": "Phosphorylation of CARMA1 by PKC-theta", "stId": "R-CFA-2730863", "stIdVersion": "R-CFA-2730863.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["Phosphorylation of CARMA1 by PKC-theta"], "releaseDate": "2026-03-25", "speciesName": "Canis familiaris", "inferredFrom": [2730863], "species": [{"dbId": 49646, "displayName": "Canis familiaris", "name": ["Canis familiaris", "Canis lupus familiaris"], "taxId": "9615", "abbreviation": "CFA", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10168026, "displayName": "Phosphorylation of CARMA1 by PKC-theta", "stId": "R-RNO-2730863", "stIdVersion": "R-RNO-2730863.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["Phosphorylation of CARMA1 by PKC-theta"], "releaseDate": "2026-03-25", "speciesName": "Rattus norvegicus", "inferredFrom": [2730863], "species": [{"dbId": 48895, "displayName": "Rattus norvegicus", "name": ["Rattus norvegicus", "R. norvegicus", "Rn", "brown rat", "Norway rat"], "taxId": "10116", "abbreviation": "RNO", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10046291, "displayName": "Phosphorylation of CARMA1 by PKC-theta", "stId": "R-MMU-2730863", "stIdVersion": "R-MMU-2730863.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["Phosphorylation of CARMA1 by PKC-theta"], "releaseDate": "2026-03-25", "speciesName": "Mus musculus", "inferredFrom": [2730863], "species": [{"dbId": 48892, "displayName": "Mus musculus", "name": ["Mus musculus", "M. musculus", "Mm", "house mouse"], "taxId": "10090", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 3139040, "displayName": "Roncagalli, Romain, 2013-02-13", "dateTime": "2013-02-13 21:56:18", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 2685547, "displayName": "CARMA1 (CARD11/Caspase recruitment domain-containing protein...", "text": "CARMA1 (CARD11/Caspase recruitment domain-containing protein 11), BCL10 (B-cell lymphoma/leukemia 10) and MALT1 (Mucosa-associated lymphoid tissue lymphoma translocation protein 1)/paracaspase have been identified as signaling components that act downstream of PKC-theta. CARMA1 is a scaffold protein and recruits BCL10, MALT1, PKC and TRAF6 to form a multi protein complex. CARMA1 exists in an inactive conformation in which the linker region binds to and blocks the accessibility of the CARD motif. Upon stimulation S552 and S645 linker residues are phosphorylated by PKC-theta and this may weaken this interaction, inducing an open conformation of CARMA1. Further phosphorylation studies have revealed other phosphorylation sites (S109, S551 and S555) that may also promote activation of CARMA1. Serene/threonine kinases PKC-beta, IKKbeta, HPK1 and CaMKII are involved in triggering CARMA1 activation (Thome et al. 2010, Rueda & Thome 2005). (only phosphorylated S552 and S645 are represented in this reaction)", "literatureReference": [203254, 2685482], "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"],