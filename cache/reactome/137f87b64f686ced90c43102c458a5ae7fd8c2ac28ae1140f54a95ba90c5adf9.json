": "Reaction"}, {"dbId": 10327869, "displayName": "Phosphorylation of CDC25A by p38 MAPK", "stId": "R-CFA-9942578", "stIdVersion": "R-CFA-9942578.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["Phosphorylation of CDC25A by p38 MAPK"], "releaseDate": "2026-03-25", "speciesName": "Canis familiaris", "inferredFrom": [9942578], "species": [{"dbId": 49646, "displayName": "Canis familiaris", "name": ["Canis familiaris", "Canis lupus familiaris"], "taxId": "9615", "abbreviation": "CFA", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10221156, "displayName": "Phosphorylation of CDC25A by p38 MAPK", "stId": "R-RNO-9942578", "stIdVersion": "R-RNO-9942578.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["Phosphorylation of CDC25A by p38 MAPK"], "releaseDate": "2026-03-25", "speciesName": "Rattus norvegicus", "inferredFrom": [9942578], "species": [{"dbId": 48895, "displayName": "Rattus norvegicus", "name": ["Rattus norvegicus", "R. norvegicus", "Rn", "brown rat", "Norway rat"], "taxId": "10116", "abbreviation": "RNO", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10097738, "displayName": "Phosphorylation of CDC25A by p38 MAPK", "stId": "R-MMU-9942578", "stIdVersion": "R-MMU-9942578.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["Phosphorylation of CDC25A by p38 MAPK"], "releaseDate": "2026-03-25", "speciesName": "Mus musculus", "inferredFrom": [9942578], "species": [{"dbId": 48892, "displayName": "Mus musculus", "name": ["Mus musculus", "M. musculus", "Mm", "house mouse"], "taxId": "10090", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}], "species": [48887], "summation": [{"dbId": 9942588, "displayName": "<p>p38 MAPK (MAPK14) phosphorylates full-length CDC25A in vi...", "text": "<p>p38 MAPK (MAPK14) phosphorylates full-length CDC25A in vitro on serine residues S76 and S124, but phosphorylates CDC25A peptide fragment only on serine residue S124 (Goloudina et al. 2003). The kinase inhibitor PD-169316, which inhibits p38 MAPKs alpha (MAPK14) and beta (MAPK11), has no effect on CDC25A levels after ultraviolet (UV) irradiation, but inhibits CDC25A degradation and G1/S checkpoint activation in response to osmotic stress, when cells are put in a hypertonic medium (Goloudina et al. 2003). While both S76 and S124 residues of CDC25A are phosphorylated in response to osmotic stress in a p38 MAPK-dependent manner, CDC25A S76A but not CDC25A S124A mutant is stable under osmotic stress (Goloudina et al. 2003). However, ectopic expression of neither CDC25A S76A nor CDC25A S124A nor the double mutant CDC25A S76A;S124A prevents the G1/S checkpoint activation under osmotic stress, implying additional regulatory mechanisms (Goloudina et al. 2003).</p><p>Based on studies in Xenopus, besides p38 MAPK, ERK kinases (MAPK1 and MAPK3) and their effector kinase RPS6KA1 (p90RSK) may also contribute to phosphorylation and SCF-BTrCP-mediated degradation of CDC25A (Isoda et al. 2009).</p>", "literatureReference": [9942580, {"dbId": 9943663, "displayName": "The extracellular signal-regulated kinase-mitogen-activated protein kinase pathway phosphorylates and targets Cdc25A for SCF beta-TrCP-dependent degradation for cell cycle arrest", "title": "The extracellular signal-regulated kinase-mitogen-activated protein kinase pathway phosphorylates and targets Cdc25A for SCF beta-TrCP-dependent degradation for cell cycle arrest", "journal": "Mol Biol Cell", "pages": "2186-95", "pubMedIdentifier": 19244340, "volume": 20, "year": 2009, "url": "http://www.ncbi.nlm.nih.gov/pubmed/19244340", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}], "className": "Summation", "schemaClass": "Summation"}], "review