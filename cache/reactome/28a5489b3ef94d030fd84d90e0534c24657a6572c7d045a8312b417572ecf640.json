}, {"dbId": 10166470, "displayName": "MAPK3-3 or MAPK1 phosphorylate GORASP2", "stId": "R-RNO-2422927", "stIdVersion": "R-RNO-2422927.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["MAPK3-3 or MAPK1 phosphorylate GORASP2"], "releaseDate": "2026-03-25", "speciesName": "Rattus norvegicus", "inferredFrom": [2422927], "species": [{"dbId": 48895, "displayName": "Rattus norvegicus", "name": ["Rattus norvegicus", "R. norvegicus", "Rn", "brown rat", "Norway rat"], "taxId": "10116", "abbreviation": "RNO", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10044744, "displayName": "MAPK3-3 or MAPK1 phosphorylate GORASP2", "stId": "R-MMU-2422927", "stIdVersion": "R-MMU-2422927.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["MAPK3-3 or MAPK1 phosphorylate GORASP2"], "releaseDate": "2026-03-25", "speciesName": "Mus musculus", "inferredFrom": [2422927], "species": [{"dbId": 48892, "displayName": "Mus musculus", "name": ["Mus musculus", "M. musculus", "Mm", "house mouse"], "taxId": "10090", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 2463852, "displayName": "Wang, Yanzhuang, 2012-08-19", "dateTime": "2012-08-19 04:00:00", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}, {"dbId": 2507813, "displayName": "Malhotra, Vivek, 2012-08-15", "dateTime": "2012-08-15 04:00:00", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}, {"dbId": 2463846, "displayName": "Colanzi, Antonino, 2012-08-21", "dateTime": "2012-08-21 04:00:00", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 2422932, "displayName": "GORASP2 (GRASP55) localizes to the median region of Golgi, w...", "text": "GORASP2 (GRASP55) localizes to the median region of Golgi, where it forms a complex with BLZF1 (Golgin 45) and RAB2A GTPase (Short et al. 2001). Similar to GORASP1, GORASP2 is involved in the maintenance of Golgi structure and positively regulates stacking of Golgi cisternae (Xiang and Wang 2010). In addition, GORASP2, probably through its association with RAB2A GTPase, regulates trafficking through the Golgi (Short et al. 2001). In G2 and mitotic prophase, GORASP2 is phosphorylated by MEK1/2 activated MAP kinases. Monophosphorylated MAPK3 (ERK1) isoform, MAPK3 3 i.e. ERK1b (known as ERK1c in rat), likely activated by a MEK1 isoform MEK1b (Shaul et al. 2009), as well as MAPK1 (ERK2) are implicated in GORASP2 phosphorylation during mitosis (Jesch et al. 2001, Colanzi et al. 2003, Shaul and Seger 2006, Feinstein and Linstedt 2007, Duran et al. 2008, Feinstein and Linstedt 2008). Threonine residues T222 and T225 were implicated as targets of MAPK mediated GORASP2 phosphorylation in studies that used directional mutagenesis (Jesch et al. 2001, Feinstein and Linstedt 2008). However both T222 and T225 were simultaneously mutated in these studies and their roles have not been individually investigated. Using mass spectroscopy, T225 but not T222 was identified as a GORASP2 residue phosphorylated by mitotic cytosol (Duran et al. 2008). T249 residue of GORASP2 was also phosphorylated by mitotic cytosol, but the involvement of ERKs in T249 phosphorylation has not been examined (Duran et al. 2008).", "literatureReference": [2422955, 2422952, 2463807, 2422957, 2422963, 2422929, 2422935, 2422949, 2422948], "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "updateTrackers": [{"dbId": 9788310, "displayName": "Update Tracker - [Reaction:2422927] MAPK3-3 or MAPK1 phosphorylate GORASP2 - v43:[modifyText]", "action": ["modifyText"], "updatedInstance": [2422927], "className": "