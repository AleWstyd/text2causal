es": [48887, {"dbId": 48892, "displayName": "Mus musculus", "name": ["Mus musculus", "M. musculus", "Mm", "house mouse"], "taxId": "10090", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "isChimeric": true, "category": "binding", "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 9037710, "displayName": "Castr\u00e9n, Eero, 2018-02-13", "dateTime": "2018-02-13 05:00:00", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}, {"dbId": 9037707, "displayName": "Antila, Hanna, 2018-02-13", "dateTime": "2018-02-13 05:00:00", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 9026533, "displayName": "Autophosphorylated tyrosine Y817 of NTRK2 (corresponds to Y7...", "text": "Autophosphorylated tyrosine Y817 of NTRK2 (corresponds to Y785 of the mature rat Ntrk2) is a docking site for PLCG1 (PLCgamma1), an activator of signaling via secondary messengers DAG and IP3 (Minichiello et al. 1998, McCarthy and Feinstein 1999, Minichiello et al. 2002). PLCG1 is recruited to Y817 of NTRK2 in response to BDNF stimulation (Minichiello et al. 1998, McCarthy and Feinstein 1999) and is also recruited to NTF4-activated NTRK2 (Minichiello et al. 1998). Recruitment on PLCG1 to NTRK2 in response to stimulation by NTF3 has not been examined.", "literatureReference": [9026486, 9026468, 9036991], "className": "Summation", "schemaClass": "Summation"}], "negativePrecedingEvent": [{"dbId": 9865778, "displayName": "Futile Cycle: Activated PCLG1 dissociates from NTRK2", "precedingEvent": [9026531], "className": "NegativePrecedingEvent", "schemaClass": "NegativePrecedingEvent"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "isChimeric": false, "category": "binding", "input": [{"dbId": 167682, "displayName": "PLCG1 [plasma membrane]", "stId": "R-HSA-167