M. musculus", "Mm", "house mouse"], "taxId": "10090", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 9608076, "displayName": "Niskanen, Einari, 2018-05-09", "dateTime": "2018-05-09 17:50:08", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}, {"dbId": 9615865, "displayName": "Niskanen, Einari, 2018-08-08", "dateTime": "2018-08-08 23:21:47", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 4656973, "displayName": "NFKBIA (IKBA, IkappaBalpha) is SUMOylated at lysine-21 with ...", "text": "NFKBIA (IKBA, IkappaBalpha) is SUMOylated at lysine-21 with SUMO1 (Desterro et al. 1998, Rodriguez et al. 2001, Liu et al. 2009). SUMOylation blocks ubiquitin-mediated proteolysis of NFKBIA and thereby inhibits NF-kappaB dependent transcription and acts as an anti-inflammatory. Adenosine signaling increases SUMOylation of NFKBIA with SUMO1. Nuclear import of NFKBIA is required for SUMOylation.", "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "updateTrackers": [{"dbId": 9774995, "displayName": "Update Tracker - [Reaction:4656914] SUMOylation of NFKBIA with SUMO1 - v80:[add_removeOutput]", "action": ["add_removeOutput"], "updatedInstance": [4656914], "className": "UpdateTracker", "schemaClass": "UpdateTracker"}], "isChimeric": false, "category": "transition", "catalystActivity": [{"dbId": 2997650, "displayName": "SUMO transferase activity of SUMO1:C93-UBE2I [nucleoplasm]", "catalyzedEvent": [4656914], "physicalEntity": {"dbId": 2993783, "displayName": "SUMO1:C93-UBE2I [nucleoplasm]", "stId": "R-HSA-2993783", "stIdVersion": "R-HSA-2993783.2", "maxDepth": 2, "name": ["SUMO1:C93-UBE2I", "SUMO1 S-glycyl-cys