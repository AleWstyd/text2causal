egativeRegulation", "className": "NegativeRegulation"}], "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10093109, "displayName": "Active IKBKB phosphorylates NF-kappa-B inhibitor ", "stId": "R-MMU-9773803", "stIdVersion": "R-MMU-9773803.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["Active IKBKB phosphorylates NF-kappa-B inhibitor "], "releaseDate": "2026-03-25", "speciesName": "Mus musculus", "inferredFrom": [9773803], "species": [{"dbId": 48892, "displayName": "Mus musculus", "name": ["Mus musculus", "M. musculus", "Mm", "house mouse"], "taxId": "10090", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "category": "transition", "regulatedBy": [{"dbId": 9996868, "displayName": "Negative regulation by 'NKIRAS [cytosol]'", "regulatedEntity": [10093109], "schemaClass": "NegativeRegulation", "className": "NegativeRegulation"}], "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 9773242, "displayName": "de Martin, R, 2022-05-04", "dateTime": "2022-05-04 04:10:14", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}, {"dbId": 2023355, "displayName": "D'Eustachio, P, 2011-12-07", "dateTime": "2011-12-08 02:10:50", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 9773805, "displayName": "In human, IkBs (NFKBIA, NFKBIB or NFKBIE) are inhibitory pro...", "text": "In human, IkBs (NFKBIA, NFKBIB or NFKBIE) are inhibitory proteins that sequesters NF-kappa-B in the cytoplasm by masking a nuclear localization signal, located just at the C-terminal end of the RelA (p65) subunit of the RelA:NFKB1 heterodimer.<p>A key event in NF-kappa-B activation involves phosphorylation of IkB by an IkB kinase (IKK). The phosphorylation and ubiquitination of IkB kinase complex is mediated by two distinct pathways, either the classical or alternative pathway. In the classical NF-kappa-B signaling pathway, the activated IKK (IkB kinase) complex, predominantly acting through IKK beta (IKKb, IKBKB) in an IKK gamma (IKBKG, NEMO)-dependent manner, catalyzes the phosphorylation of IkBs (at sites equivalent to Ser32 and Ser36 of human NFKBIA (IkB-alpha) or Ser19 and Ser22 of NFKBIB (IkB-beta)). Once phosphorylated, IkB undergoes ubiquitin-mediated degradation, releasing NF-kappa-B.<br>", "literatureReference": [{"dbId": 434140, "displayName": "IKKalpha, IKKbeta, and NEMO/IKKgamma are each required for the NF-kappa B-mediated inflammatory response program", "title": "IKKalpha, IKKbeta, and NEMO/IKKgamma are each required for the NF-kappa B-mediated inflammatory response program", "journal": "J Biol Chem", "pages": "45129-40", "pubMedIdentifier": 12221085, "volume": 277, "year": 2002, "url": "http://www.ncbi.nlm.nih.gov/pubmed/12221085", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}, {"dbId": 434149, "displayName": "The nemo binding domains of both IKKalpha and IKKbeta regulate IKK complex assembly and classical NFkappaB activation", "title": "The nemo binding domains of both IKKalpha and IKKbeta regulate IKK complex assembly and classical NFkappaB activation", "journal": "J Biol Chem", "pubMedIdentifier": 19666475, "year": 2009, "url": "http://www.ncbi.nlm.nih.gov/pubmed/19666475", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}], "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "systematicName": "CHUK:IKBKB:IKBKG phosphorylates IkBs:NFkB", "category": "transition", "catalystActivity": [{"dbId": 9773806, "displayName": "protein serine/threonine kinase activity of CHUK:p-S177,S181-IKBKB:IKBKG [cytosol]", "catalyzedEvent": [9773803], "physicalEntity": {"dbId": 202513, "displayName": "CHUK:p-S177,S181-IKBKB:IKBKG [cytosol]", "stId": "R-HSA-202513", "stIdVersion": "R-HSA-202513