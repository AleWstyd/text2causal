playName": "Upon engagement of CTLA4 by B7 molecules, PP2A dissociates f...", "text": "Upon engagement of CTLA4 by B7 molecules, PP2A dissociates from CTLA4 in a phosphorylation-dependent manner. Once released, PP2A acts downstream of early TCR and CD28 signaling by inhibiting the PKB/Akt pathway, leading to the suppression of T cell activation and proliferation. This mechanism highlights PP2A's role in modulating key signaling pathways to maintain immune homeostasis (Parry et al. 2005).", "literatureReference": [390214, {"dbId": 9927337, "displayName": "CTLA-4 and PD-1 receptors inhibit T-cell activation by distinct mechanisms", "title": "CTLA-4 and PD-1 receptors inhibit T-cell activation by distinct mechanisms", "journal": "Mol Cell Biol", "pages": "9543-53", "pubMedIdentifier": 16227604, "volume": 25, "year": 2005, "url": "http://www.ncbi.nlm.nih.gov/pubmed/16227604", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}], "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "updateTrackers": [{"dbId": 9928447, "displayName": "Update Tracker - [Reaction:390329] Dephosphorylation of AKT by PP2A - v91:[modifyText]", "action": ["modifyText"], "updatedInstance": [390329], "className": "UpdateTracker", "schemaClass": "UpdateTracker"}, {"dbId": 9779708, "displayName": "Update Tracker - [Reaction:390329] Dephosphorylation of AKT by PP2A - v64:[add_removeInput, add_removeOutput]", "action": ["add_removeInput", "add_removeOutput"], "updatedInstance": [390329], "className": "UpdateTracker", "schemaClass": "UpdateTracker"}], "category": "transition", "catalystActivity": [{"dbId": 390328, "displayName": "phosphatidate phosphatase activity of PP2A [cytosol]", "catalyzedEvent": [390329], "physicalEntity": {"dbId": 196206, "displayName": "PP2A [cytosol]", "stId": "R-HSA-19