musculus", "name": ["Mus musculus", "M. musculus", "Mm", "house mouse"], "taxId": "10090", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 350667, "displayName": "Friedman, WJ, 2008-05-20 12:23:46", "dateTime": "2008-05-20 16:23:46", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}, {"dbId": 351795, "displayName": "Chao, MV, 2008-05-28 09:46:01", "dateTime": "2008-05-28 13:46:01", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 194360, "displayName": "The different molecules listed (NRAGE, NRIF, NADE, TRAF6) me...", "text": "The different molecules listed (NRAGE, NRIF, NADE, TRAF6) mediate, through unclear mechanisms, JNK activation by threonine and tyrosine phosphorylation. While active JNK does move to the nucleus and phosphorylates and activate transcription factors such as c-JUN and ATF2, these have not been implicated in p75-mediated cell death, but rather the direct activation of the cell death machinery by JNK has been implicated. p75 activates the intrinsic caspase pathway (involving mitochondrial release of cytochrome c, Apaf-1, and caspases-9) rather than the extrinsic (caspase-8) pathway activated by most other death receptors.", "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "category": "transition", "input": [{"dbId": 194371, "displayName": "p-T,Y-MAPK8 [cytosol]", "stId": "R-HSA-194371", "stIdVersion": "R-HSA-194371.1", "maxDepth": 1, "name": ["p-T,Y-MAPK8", "p-T,Y-JNK1", "mitogen-activated protein kinase 8 (phosphorylated)"], "speciesName": "Homo sapiens", "catalystActivities": [{"dbId": 217311, "displayName": "JUN kinase activity of p-T,Y-MAPK8 [cytosol]", "physicalE