"], "releaseDate": "2026-03-25", "speciesName": "Canis familiaris", "inferredFrom": [2029469], "species": [{"dbId": 49646, "displayName": "Canis familiaris", "name": ["Canis familiaris", "Canis lupus familiaris"], "taxId": "9615", "abbreviation": "CFA", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10162732, "displayName": "p-ERK phosphorylates WAVEs and ABI", "stId": "R-RNO-2029469", "stIdVersion": "R-RNO-2029469.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["p-ERK phosphorylates WAVEs and ABI"], "releaseDate": "2026-03-25", "speciesName": "Rattus norvegicus", "inferredFrom": [2029469], "species": [{"dbId": 48895, "displayName": "Rattus norvegicus", "name": ["Rattus norvegicus", "R. norvegicus", "Rn", "brown rat", "Norway rat"], "taxId": "10116", "abbreviation": "RNO", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 2248842, "displayName": "Rosales, C, 2012-05-14", "dateTime": "2012-05-15 02:40:44", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}, {"dbId": 5668821, "displayName": "Rivero Crespo, Francisco, 2014-12-26", "dateTime": "2014-12-26 05:00:00", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 2028776, "displayName": "The ARP2/3 complex shows higher affinity for the phosphoryla...", "text": "The ARP2/3 complex shows higher affinity for the phosphorylated VCA domain of WAVE2 than for the unphosphorylated VCA domain. WAVE proteins can be phosphorylated by various kinases. Active ERK (Mitogen activated protein kinase 3) phosphorylates the WAVE regulatory complex (WRC) on multiple serine/threonine sites within the proline-rich domains (PRDs) of WAVE2 and ABI1. Phosphorylation of the PRDs would disrupt their interaction with SH3 and PLP binding domains, potentially altering WRC activation. ERK phosphorylates both S343 and T346 in WAVE2 and S183, S216, S225, S392, and S410 in ABI1. Cumulatively, the phosphorylation of both WAVE2 and ABI in the WAVE regulatory complex (WRC) contributes to the RAC-induced WRC conformational change that exposes the VCA domain, leading to binding and activation of ARP2/3 (Mendoza et al. 2011, Nakanishi et al. 2007). ERK phosphorylation sites in WAVE2 are not strictly conserved in WAVE1 and WAVE3 but, based on the amino acid sequence, other potential ERK phosphorylation sites exist. ", "literatureReference": [2028867, 2028805, {"dbId": 2028863, "displayName": "Structure and control of the actin regulatory WAVE complex", "title": "Structure and control of the actin regulatory WAVE complex", "journal": "Nature", "pages": "533-8", "pubMedIdentifier": 21107423, "volume": 468, "year": 2010, "url": "http://www.ncbi.nlm.nih.gov/pubmed/21107423", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}], "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "updateTrackers": [{"dbId": 9785221, "displayName": "Update Tracker - [Reaction:2029469] p-ERK phosphorylates WAVEs and ABI - v52:[add_removeCatalystActivity, add_removeInput, modifyText]", "action": ["add_removeCatalystActivity", "add_removeInput", "modifyText"], "updatedInstance": [2029469], "className": "UpdateTracker", "schemaClass": "UpdateTracker"}], "isChimeric": false, "category": "transition", "catalystActivity": [{"dbId": 4793923, "displayName": "protein serine/threonine kinase activity of p-T,Y MAPK dimers [cytosol]", "catalyzedEvent": [2029469], "physicalEntity": {"dbId": 1268261, "displayName": "p-T,Y MAPK dimers [cytosol]", "stId": "R-HSA-1268261", "stIdVersion": "R-HSA-1268261.1", "maxDepth": 3, "name": ["p-T,Y MAPK dimers", "p-ERK dimer"], "species