eins (reviewed in Briscoe and Therond, 2013; Mukhopadhyay and Rohatgi, 2014).", "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "isChimeric": false, "category": "binding", "input": [{"dbId": 5610571, "displayName": "PKA tetramer [ciliary base]", "stId": "R-HSA-5610571", "stIdVersion": "R-HSA-5610571.1", "maxDepth": 3, "name": ["PKA tetramer"], "speciesName": "Homo sapiens", "consumedByEvent": [5610749], "isChimeric": false, "species": [48887], "inDisease": false, "schemaClass": "Complex", "className": "Complex"}, {"dbId": 30389, "displayName": "cAMP [cytosol]", "stId": "R-ALL-30389", "stIdVersion": "R-ALL-30389.4", "maxDepth": 1, "name": ["cAMP", "Cyclic adenylic acid", "3',5'-cyclic AMP", "Cyclic AMP", "Adenosine 3',5'-phosphate"], "crossReference": [{"dbId": 30390, "displayName": "COMPOUND:C00575", "databaseName": "COMPOUND", "identifier": "C00575", "url": "https://www.kegg.jp/entry/C00575", "className": "DatabaseIdentifier", "schemaClass": "DatabaseIdentifier"}], "negativelyRegulates": [{"dbId": 71664, "displayName": "Negative regulation by 'cAMP [cytosol]'", "stId": "R-HSA-71664", "stIdVersion": "R-HSA-71664.1", "regulator": 30389, "schemaClass": "NegativeRegulation", "className": "NegativeRegulation"}], "consumedByEvent": [5610749, 5610749, 5610749, 5610749], "referenceType": "ReferenceMolecule", "className": "Chemical Compound", "inDisease": false, "schemaClass": "SimpleEntity"}, 30389, 30389, 30389], "output": [{"dbId": 5610569, "displayName": "PKA catalytic subunit [ciliary base]", "stId": "R-HSA-5610569", "stIdVersion": "R-HSA-5610569.1", "maxDepth": 2, "name": ["PKA catalytic subunit"], "speciesName": "Homo sapiens", "catalystActivities": [{"dbId": 5610634, "displayName": "cAMP-dependent protein kinase activity of PKA catalytic subunit [ciliary base]", "physicalEntit