sitiveRegulation", "className": "PositiveRegulation"}], "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10165344, "displayName": "Endocytosis of TLR4:LY96:LPS:CD14", "stId": "R-RNO-2201293", "stIdVersion": "R-RNO-2201293.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["Endocytosis of TLR4:LY96:LPS:CD14"], "releaseDate": "2026-03-25", "speciesName": "Rattus norvegicus", "inferredFrom": [2201293], "species": [{"dbId": 48895, "displayName": "Rattus norvegicus", "name": ["Rattus norvegicus", "R. norvegicus", "Rn", "brown rat", "Norway rat"], "taxId": "10116", "abbreviation": "RNO", "className": "Species", "schemaClass": "Species"}], "category": "transition", "regulatedBy": [{"dbId": 10165345, "displayName": "Positive regulation by 'Dynamin-1/2/3 [plasma membrane]'", "regulatedEntity": [10165344], "schemaClass": "PositiveRegulation", "className": "PositiveRegulation"}, {"dbId": 10165346, "displayName": "Positive regulation by 'PLCG2 [cytosol]'", "regulatedEntity": [10165344], "schemaClass": "PositiveRegulation", "className": "PositiveRegulation"}], "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 2581520, "displayName": "Granucci, Francesca, Zanoni, Ivan, 2012-11-13", "dateTime": "2012-11-13 23:21:27", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}, {"dbId": 2272817, "displayName": "D'Eustachio, P, 2012-05-25", "dateTime": "2012-05-25 21:41:20", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 2206269, "displayName": "Upon LPS stimulation TLR4 is internalized into endosomes whe...", "text": "Upon LPS stimulation TLR4 is internalized into endosomes where the signaling pathway is triggered through the adaptors TRAM and TRIF leading to the activation of IRF3 and induction of IFN-beta [Tanimuro N et al 2008; Kagan JC et al 2008]. While TLR4 translocation to endosomes is governed by known regulators of general endocytic processes such as dynamins and clathrin, other proteins that specifically regulate LPS-stimulated TLR4 endocytosis have been also identified [Husebye et al 2006; Kagan JC et al 2008; Zanoni I et al 2011]. Thus, CD14 has been implicated both in transporting LPS to TLR4 and in delivering TLR4 to an endosomal compartment. TLR4 translocation activated by CD14 appears to be Syk-mediated, and requires its downstream effector phospholipase C gamma 2 (PLCgamma2), which in turn induces a drop in the concentration of PIP2 required for endosomal sealing  [Zanoni I et al 2011]. It has also been shown that PLCgamma2 induces inositol 1,4,5-trisphosphate (IP(3)) production and subsequent calcium (Ca2+) release. Released intracellular Ca2+ was reported to mediate TLR4 trafficking and subsequent activation of IRF3. [Aki D et al 2008; Chiang CY et al 2012].", "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "updateTrackers": [{"dbId": 9788321, "displayName": "Update Tracker - [Reaction:2201293] Endocytosis of TLR4:LY96:LPS:CD14 - v43:[modifyText]", "action": ["modifyText"], "updatedInstance": [2201293], "className": "UpdateTracker", "schemaClass": "UpdateTracker"}, {"dbId": 9775094, "displayName": "Update Tracker - [Reaction:2201293] Endocytosis of TLR4:LY96:LPS:CD14 - v80:[add_removeRegulator]", "action": ["add_removeRegulator"], "updatedInstance": [2201293], "className": "UpdateTracker", "schemaClass": "UpdateTracker"}], "isChimeric": false, "category": "transition", "input": [{"dbId": 166850, "displayName": "TLR4:LY96:LPS:CD14 [plasma membrane]", "stId": "R-HSA-166850", "stIdVersion": "R-HSA-166850.1", "maxDepth": 3, "name": ["TLR4:LY96:LPS:CD14"], "speciesName": "Homo sapiens", "literatureReference": [5467275, {"dbId": 2423816, "displayName": "Lipopolysaccharide interaction with cell surface Toll-like receptor 4-MD-2