, "isInferred": true, "maxDepth": 1, "name": ["mTORC2 phosphorylates AKT at S473"], "releaseDate": "2026-03-25", "speciesName": "Mus musculus", "inferredFrom": [198640], "species": [{"dbId": 48892, "displayName": "Mus musculus", "name": ["Mus musculus", "M. musculus", "Mm", "house mouse"], "taxId": "10090", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "category": "transition", "regulatedBy": [{"dbId": 10002500, "displayName": "Negative regulation by 'AKT:PIP3:THEM4/TRIB3 [plasma membrane]'", "regulatedEntity": [10002499], "schemaClass": "NegativeRegulation", "className": "NegativeRegulation"}], "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 202668, "displayName": "Greene, LA, 2007-11-08 15:39:37", "dateTime": "2007-11-08 20:39:37", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}, {"dbId": 2463854, "displayName": "Zhao, Jean J, 2012-08-13", "dateTime": "2012-08-13 04:00:00", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}, {"dbId": 2463859, "displayName": "Yuzugullu, Haluk, 2012-08-13", "dateTime": "2012-08-13 04:00:00", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}, {"dbId": 2463860, "displayName": "Thorpe, Lauren, 2012-08-13", "dateTime": "2012-08-13 04:00:00", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "revised": [{"dbId": 2422427, "displayName": "Orlic-Milacic, M, 2012-07-18", "dateTime": "2012-07-18 22:25:21", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 202051, "displayName": "Under conditions of growth and mitogen stimulation S473 phos...", "text": "Under conditions of growth and mitogen stimulation S473 phosphorylation of AKT is carried out by mTOR (mammalian Target of Rapamycin). This kinase is found in two structurally and functionally distinct protein complexes, named TOR complex 1 (TORC1) and TOR complex 2 (TORC2).  It is TORC2 complex, which is composed of mTOR, RICTOR, SIN1 (also named MAPKAP1) and LST8, that phosphorylates AKT at S473 (Sarbassov et al., 2005). This complex also regulates actin cytoskeletal reorganization (Jacinto et al., 2004; Sarbassov et al., 2004). TORC1, on the other hand, is a major regulator of ribosomal biogenesis and protein synthesis (Hay and Sonenberg, 2004). TORC1 regulates these processes largely by the phosphorylation/inactivation of the repressors of mRNA translation 4E binding proteins (4E BPs) and by the phosphorylation/activation of ribosomal S6 kinase (S6K1). TORC1 is also the principal regulator of autophagy. In other physiological conditions, other kinases may be responsible for AKT S473 phosphorylation.<br>\nPhosphorylation of AKT on S473 by TORC2 complex is a prerequisite for AKT phosphorylation on T308 by PDPK1 (Scheid et al. 2002, Sarabassov et al. 2005).", "literatureReference": [199373, 199317, {"dbId": 199316, "displayName": "Mammalian TOR complex 2 controls the actin cytoskeleton and is rapamycin insensitive", "title": "Mammalian TOR complex 2 controls the actin cytoskeleton and is rapamycin insensitive", "journal": "Nat Cell Biol", "pages": "1122-8", "pubMedIdentifier": 15467718, "volume": 6, "year": 2004, "url": "http://www.ncbi.nlm.nih.gov/pubmed/15467718", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}, {"dbId": 443392, "displayName": "PIKKing on PKB: regulation of PKB activity by phosphorylation", "title": "PIKKing on PKB: regulation of PKB activity by phosphorylation", "journal": "Curr Opin Cell Biol", "pages": "256-61", "pubMedIdentifier": 19303758, "volume": 21, "year": 2009, "url": "http://www.ncbi.nlm.nih.gov/pubmed/19303758", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}, {"dbId": 199376, "displayName": "Rictor, a novel binding partner of mTOR, defines a rapamycin-insensitive and raptor-independent pathway that regulates the cytoskeleton", "title": "Rictor, a novel binding partner of mTOR, defines a rapamycin-insensitive and raptor