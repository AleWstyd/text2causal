: "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}], "species": [48887], "summation": [{"dbId": 1986604, "displayName": "ADRBK1 (also known as GRK2) is phosphorylated at serine 29 i...", "text": "ADRBK1 (also known as GRK2) is phosphorylated at serine 29 in vitro and in vivo by the alpha, gamma and delta isoforms of PKC.  PKC-mediated phosphorylation at Ser29 increases ADRBK1 kinase activity towards GPCR substrates, contributing to GPCR desensitization.  Phosphorylation at Ser29, which falls within the calmodulin-binding region of ADRBK1, abolishes the inhibitory effect of calmodulin on ADRBK1 kinase activity.", "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "updateTrackers": [{"dbId": 9789006, "displayName": "Update Tracker - [Reaction:111970] PKC phosphorylates GRK2 - v39:[addSummation]", "action": ["addSummation"], "updatedInstance": [111970], "className": "UpdateTracker", "schemaClass": "UpdateTracker"}, {"dbId": 9782555, "displayName": "Update Tracker - [Reaction:111970] PKC phosphorylates GRK2 - v59:[modifyText]", "action": ["modifyText"], "updatedInstance": [111970], "className": "UpdateTracker", "schemaClass": "UpdateTracker"}], "category": "transition", "catalystActivity": [{"dbId": 111967, "displayName": "protein serine/threonine kinase activity of active PKC (alpha, gamma, delta) [cytosol]", "catalyzedEvent": [111970], "physicalEntity": {"dbId": 112002, "displayName": "active PKC (alpha, gamma, delta) [cytosol]", "stId": "R-HSA-112002", "stIdVersion": "R-HSA-112002.1", "maxDepth": 3, "name": ["active PKC (alpha, gamma, delta)"], "speciesName": "Homo sapiens", "catalystActivities": [111967], "inDisease": false, "schemaClass": "Complex", "className": "Complex"}, "className": "CatalystActivity", "schemaClass": "CatalystActivit