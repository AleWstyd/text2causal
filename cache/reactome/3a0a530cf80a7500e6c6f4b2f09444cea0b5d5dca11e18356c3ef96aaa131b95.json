 "schemaClass": "Species"}], "category": "binding", "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10175230, "displayName": "DAG and Ca+2 bind to PKC and tether it to membrane", "stId": "R-RNO-5218813", "stIdVersion": "R-RNO-5218813.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["DAG and Ca+2 bind to PKC and tether it to membrane"], "releaseDate": "2026-03-25", "speciesName": "Rattus norvegicus", "inferredFrom": [5218813], "species": [{"dbId": 48895, "displayName": "Rattus norvegicus", "name": ["Rattus norvegicus", "R. norvegicus", "Rn", "brown rat", "Norway rat"], "taxId": "10116", "abbreviation": "RNO", "className": "Species", "schemaClass": "Species"}], "category": "binding", "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10052885, "displayName": "DAG and Ca+2 bind to PKC and tether it to membrane", "stId": "R-MMU-5218813", "stIdVersion": "R-MMU-5218813.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["DAG and Ca+2 bind to PKC and tether it to membrane"], "releaseDate": "2026-03-25", "speciesName": "Mus musculus", "inferredFrom": [5218813], "species": [{"dbId": 48892, "displayName": "Mus musculus", "name": ["Mus musculus", "M. musculus", "Mm", "house mouse"], "taxId": "10090", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "category": "binding", "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 5432673, "displayName": "Welsh, Michael, Berger, Philipp, Ballmer-Hofer, Kurt, 2014-05-12", "dateTime": "2014-05-12 12:46:47", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 5218537, "displayName": "PKC contains a N-terminal C2 like domain, a pseudosubstrate ...", "text": "PKC contains a N-terminal C2 like domain, a pseudosubstrate (PS), DAG binding (C1) domain and a C-terminal kinase domain. The PS sequence resembles an ideal substrate with the exception that it contains an alanine residue instead of a substrate serine residue. It is bound to the kinase domain in the resting state. As a result, PKC is maintained in a closed inactive state, inaccessible to cellular substrates. On stimulation of receptors there is an increase in intracellular calcium and diacylglycerol (DAG) levels which leads to the activation of PKC and its translocation from the cytosol to the plasma membrane. PKCs tether to the plasma membrane through DAG binding to the C1 domain. This confers a high-affinity interaction between PKC and the membrane, leading to a massive conformational change that releases the PS domain from the catalytic site, the system becomes both competent and accessible (Colon-Gonzalez & Kazanietz 2006).", "literatureReference": [5218670], "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "isChimeric": false, "category": "binding", "input": [{"dbId": 5218758, "displayName": "p-PKC [cytosol]", "stId": "R-HSA-5218758", "stIdVersion": "R-HSA-5218758.1", "maxDepth": 2, "name": ["p-PKC", "p-PKCA, p-PKCB, p-PKCD, p-PKCZ"], "speciesName": "Homo sapiens", "consumedByEvent": [5218813], "species": [48887], "className": "Set", "inDisease": false, "schemaClass": "DefinedSet"}, {"dbId": 112275, "displayName": "DAGs [plasma membrane]", "stId": "R-ALL-112275", "stIdVersion": "R-ALL-112275.3", "maxDepth": 1, "name": ["DAGs", "diacylglycerols", "diglyceride", "DAG"], "crossReference": [{"dbId": 29669, "displayName": "COMPOUND:C00165", "databaseName": "COMPOUND", "identifier": "C00165", "url": "https://www.kegg.jp/entry/C00165", "className": "DatabaseIdentifier", "schemaClass": "DatabaseIdentifier"}], "positivelyRegulates": [{"dbId": 8855329, "displayName": "Positive regulation by 'DAGs [plasma membrane]'", "stId": "R-XLA-8855329", "stIdVersion": "R-XLA-8855329.1", "regulator": 112275, "sc