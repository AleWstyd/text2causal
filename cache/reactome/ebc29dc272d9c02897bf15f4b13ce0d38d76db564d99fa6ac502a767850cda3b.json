l, 2005; reviewed in Matallanas et al, 2011).", "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "isChimeric": false, "category": "binding", "input": [{"dbId": 5674136, "displayName": "activated RAF homo/heterodimer [cytosol]", "stId": "R-HSA-5674136", "stIdVersion": "R-HSA-5674136.1", "maxDepth": 3, "name": ["activated RAF homo/heterodimer"], "speciesName": "Homo sapiens", "consumedByEvent": [5674132], "isChimeric": false, "species": [48887], "inDisease": false, "schemaClass": "Complex", "className": "Complex"}, {"dbId": 5672716, "displayName": "MAP2K homo/heterodimers [cytosol]", "stId": "R-HSA-5672716", "stIdVersion": "R-HSA-5672716.1", "maxDepth": 3, "name": ["MAP2K homo/heterodimers"], "speciesName": "Homo sapiens", "consumedByEvent": [5674132], "species": [48887], "className": "Set", "inDisease": false, "schemaClass": "DefinedSet"}, {"dbId": 169291, "displayName": "MAPKs [cytosol]", "stId": "R-HSA-169291", "stIdVersion": "R-HSA-169291.2", "maxDepth": 2, "name": ["MAPKs", "MAPK1,MAPK3"], "speciesName": "Homo sapiens", "consumedByEvent": [5674132], "species": [48887], "className": "Set", "inDisease": false, "schemaClass": "DefinedSet"}, {"dbId": 5674133, "displayName": "WDR83:LAMTOR2:LAMTOR3 [endosome membrane]", "stId": "R-HSA-5674133", "stIdVersion": "R-HSA-5674133.1", "maxDepth": 2, "name": ["WDR83:LAMTOR2:LAMTOR3"], "speciesName": "Homo sapiens", "literatureReference": [5674100], "consumedByEvent": [5674132], "isChimeric": false, "species": [48887], "inDisease": false, "schemaClass": "Complex", "className": "Complex"}], "output": [{"dbId": 5674138, "displayName": "WDR83:LAMTOR2:LAMTOR3:activated RAF:MAP2K:MAPK complex [endosome membrane]", "stId": "R-HSA-5674138", "stIdVersion": "R-HSA-5674138.1", "maxDepth": 4, "name": ["WDR83:LAMTOR2:LAMTOR3:activated RAF:MAP2K:MAPK c