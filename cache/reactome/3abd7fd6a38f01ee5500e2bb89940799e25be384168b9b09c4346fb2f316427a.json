Version": "R-RNO-8852716.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["Thrombin, ELANE cleave C5"], "releaseDate": "2026-03-25", "speciesName": "Rattus norvegicus", "inferredFrom": [8852716], "species": [{"dbId": 48895, "displayName": "Rattus norvegicus", "name": ["Rattus norvegicus", "R. norvegicus", "Rn", "brown rat", "Norway rat"], "taxId": "10116", "abbreviation": "RNO", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10076229, "displayName": "Thrombin, ELANE cleave C5", "stId": "R-MMU-8852716", "stIdVersion": "R-MMU-8852716.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["Thrombin, ELANE cleave C5"], "releaseDate": "2026-03-25", "speciesName": "Mus musculus", "inferredFrom": [8852716], "species": [{"dbId": 48892, "displayName": "Mus musculus", "name": ["Mus musculus", "M. musculus", "Mm", "house mouse"], "taxId": "10090", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 8959927, "displayName": "Bulla, Roberta, 2017-02-01", "dateTime": "2017-02-01 16:52:47", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 8852708, "displayName": "Thrombin, coagulation factors XIa, Xa, IXa and plasmin (Amar...", "text": "Thrombin, coagulation factors XIa, Xa, IXa and plasmin (Amara et al. 2010) can cleave C3 and C5 to generate C3a and C5a. Neutrophil elastase (ELANE) can cleave C5 generating an active C5a-like fragment (Vogt 2000). <br><br>Under normal conditions, thrombin cleavage of C5 may not be a physiologically significant reaction (Bagic et al. 2015) but the combined action of thrombin and convertases appears to enhance the efficiency of the lytic pathway (Krisinger et al. 2012). Clotting-induced production of thrombin leads to cleavage of C5 at the atypical site R947 in the CUB domain. C5a can be released from the atypical C5a fragment (termed C5aT) by conventional C5 convertases; the truncated C5b fragment, termed C5bT, can form a C5bT-9 membrane attack complex that has significantly increased lytic activity (Krisinger et al. 2012).", "literatureReference": [8852715, {"dbId": 4420261, "displayName": "Molecular intercommunication between the complement and coagulation systems", "title": "Molecular intercommunication between the complement and coagulation systems", "journal": "J. Immunol.", "pages": "5628-36", "pubMedIdentifier": 20870944, "volume": 185, "year": 2010, "url": "http://www.ncbi.nlm.nih.gov/pubmed/20870944", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}, {"dbId": 8852756, "displayName": "Cleavage of the fifth component of complement and generation of a functionally active C5b6-like complex by human leukocyte elastase", "title": "Cleavage of the fifth component of complement and generation of a functionally active C5b6-like complex by human leukocyte elastase", "journal": "Immunobiology", "pages": "470-7", "pubMedIdentifier": 10776801, "volume": 201, "year": 2000, "url": "http://www.ncbi.nlm.nih.gov/pubmed/10776801", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}, {"dbId": 8852517, "displayName": "Complement activation, regulation, and molecular basis for complement-related diseases", "title": "Complement activation, regulation, and molecular basis for complement-related diseases", "journal": "EMBO J.", "pages": "2735-57", "pubMedIdentifier": 26489954, "volume": 34, "year": 2015, "url": "http://www.ncbi.nlm.nih.gov/pubmed/26489954", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}], "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "isChim