 "inferredFrom": [2682349], "species": [{"dbId": 48895, "displayName": "Rattus norvegicus", "name": ["Rattus norvegicus", "R. norvegicus", "Rn", "brown rat", "Norway rat"], "taxId": "10116", "abbreviation": "RNO", "className": "Species", "schemaClass": "Species"}], "category": "transition", "regulatedBy": [{"dbId": 10167756, "displayName": "Positive regulation by 'WNKs [cytosol]'", "regulatedEntity": [10167755], "schemaClass": "PositiveRegulation", "className": "PositiveRegulation"}], "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10046032, "displayName": "RAF1:SGK:TSC22D3:WPP ubiquitinates SCNN channels", "stId": "R-MMU-2682349", "stIdVersion": "R-MMU-2682349.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["RAF1:SGK:TSC22D3:WPP ubiquitinates SCNN channels"], "releaseDate": "2026-03-25", "speciesName": "Mus musculus", "inferredFrom": [2682349], "species": [{"dbId": 48892, "displayName": "Mus musculus", "name": ["Mus musculus", "M. musculus", "Mm", "house mouse"], "taxId": "10090", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "category": "transition", "regulatedBy": [{"dbId": 10046033, "displayName": "Positive regulation by 'WNKs [cytosol]'", "regulatedEntity": [10046032], "schemaClass": "PositiveRegulation", "className": "PositiveRegulation"}], "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 3002750, "displayName": "He, Lei, 2013-01-28", "dateTime": "2013-01-28 15:36:14", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 2684913, "displayName": "Amiloride-sensitive sodium channels (SCNNs, aka ENaCs, epith...", "text": "Amiloride-sensitive sodium channels (SCNNs, aka ENaCs, epithelial Na+ channels, non voltage-gated sodium channels) comprises three subunits (alpha, beta and gamma) and plays an essential role in Na+ and fluid absorption in the kidney, colon and lung. The number of channels at the cell's surface (consequently its function) can be regulated. This is achieved by ubiquitination of SCNN via E3 ubiquitin-protein ligases (NED4L and WPP1) (Staub et al. 2000, Farr et al. 2000). NED4L/WPP1 is found in a signaling complex including Raf1 (RAF proto-oncogene serine/threonine-protein kinase), SGK (serum/glucocorticoid-regulated kinase) and GILZ (glucocorticoid-induced leucine zipper protein, TSC22D3)  (Soundararajan et al. 2009). Ubiquitinated SCNN (Ub-SCNN) is targeted for degradation so a lesser number of channels are present at the cell surface, reducing the amount of Na+ absorption. Proline-rich sequences at the C-terminus of SCNNs include the PY motif containing a PPxY sequence. PY motifs bind WW domains of NED4L/WPP1. Protein kinases with no lysine K (WNKs) can activate SCNN activity by interacting non-enzymatically with the signaling complex, specifically SGK although the mechanism is unknown (Heise et al. 2010).", "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "updateTrackers": [{"dbId": 9775078, "displayName": "Update Tracker - [Reaction:2682349] RAF1:SGK:TSC22D3:WPP ubiquitinates SCNN channels - v80:[addLiteratureReference]", "action": ["addLiteratureReference"], "updatedInstance": [2682349], "className": "UpdateTracker", "schemaClass": "UpdateTracker"}, {"dbId": 9785108, "displayName": "Update Tracker - [Reaction:2682349] RAF1:SGK:TSC22D3:WPP ubiquitinates SCNN channels - v52:[add_removeOutput]", "action": ["add_removeOutput"], "updatedInstance": [2682349], "className": "UpdateTracker", "schemaClass": "UpdateTracker"}], "isChimeric": false, "category": "transition", "catalystActivity": [{"dbId": 2682360, "displayName": "ubiquitin-protein transferase activity of RAF1:SGK:TSC22D3:WPP [cytosol]", "catalyzedEvent": [2682349], "physicalEntity": {"dbId": 2682342, "displayName": "RAF1