": [{"dbId": 9632856, "displayName": "PKC zeta (PRKCZ) is serine phosphorylated downstream of ESR1...", "text": "PKC zeta (PRKCZ) is serine phosphorylated downstream of ESR1 and estradiol stimulation. Serine phosphorylation is required for recruitment of RAS to the ESR1 complex, the estrogen-stimulated translocation of ERK2 to the nucleus and for entry into S phase (Castoria et al, 2004). Mutation of threonine 410, which is required for PRKCZ activation, abolishes serine phosphorylation, suggesting the enzyme autophosphorylates (Castoria et al, 2004).", "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "isChimeric": false, "category": "transition", "catalystActivity": [{"dbId": 9632839, "displayName": "protein serine/threonine kinase activity of PDPK1:PIP3:p-T410-PRKCZ [plasma membrane]", "catalyzedEvent": [9632858], "physicalEntity": {"dbId": 437184, "displayName": "PDPK1:PIP3:p-T410-PRKCZ [plasma membrane]", "stId": "R-HSA-437184", "stIdVersion": "R-HSA-437184.3", "maxDepth": 3, "name": ["PDPK1:PIP3:p-T410-PRKCZ"], "speciesName": "Homo sapiens", "catalystActivities": [9632839], "consumedByEvent": [9632858], "species": [48887], "inDisease": false, "schemaClass": "Complex", "className": "Complex"}, "className": "CatalystActivity", "schemaClass": "CatalystActivity"}], "input": [{"dbId": 113592, "displayName": "ATP [cytosol]", "stId": "R-ALL-113592", "stIdVersion": "R-ALL-113592.5", "maxDepth": 1, "name": ["ATP", "Adenosine 5'-triphosphate", "ATP(4-)"], "crossReference": [{"dbId": 29359, "displayName": "COMPOUND:C00002", "databaseName": "COMPOUND", "identifier": "C00002", "url": "https://www.kegg.jp/entry/C00002", "className": "DatabaseIdentifier", "schemaClass": "DatabaseIdentifier"}], "isRequired": [{"dbId": 72781, "displayName": "Requirement by 'ATP [cytosol]'", "stId": "R-HSA-