rue, "maxDepth": 1, "name": ["PIP3 recruits AKT to the membrane"], "releaseDate": "2026-03-25", "speciesName": "Mus musculus", "inferredFrom": [2317332], "species": [{"dbId": 48892, "displayName": "Mus musculus", "name": ["Mus musculus", "M. musculus", "Mm", "house mouse"], "taxId": "10090", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "category": "binding", "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 202668, "displayName": "Greene, LA, 2007-11-08 15:39:37", "dateTime": "2007-11-08 20:39:37", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}, {"dbId": 2463854, "displayName": "Zhao, Jean J, 2012-08-13", "dateTime": "2012-08-13 04:00:00", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}, {"dbId": 2463859, "displayName": "Yuzugullu, Haluk, 2012-08-13", "dateTime": "2012-08-13 04:00:00", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}, {"dbId": 2463860, "displayName": "Thorpe, Lauren, 2012-08-13", "dateTime": "2012-08-13 04:00:00", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "revised": [{"dbId": 2422427, "displayName": "Orlic-Milacic, M, 2012-07-18", "dateTime": "2012-07-18 22:25:21", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 2326765, "displayName": "PIP3 generated by PI3K recruits AKT (also known as protein k...", "text": "PIP3 generated by PI3K recruits AKT (also known as protein kinase B) to the membrane, through its PH (pleckstrin-homology) domains. The binding of PIP3 to the PH domain of AKT is the rate-limiting step in AKT activation (Scheid et al. 2002). In mammals there are three AKT isoforms (AKT1-3) encoded by three separate genes. The three isoforms share a high degree of amino acid identity and have indistinguishable substrate specificity in vitro. However, isoform-preferred substrates in vivo cannot be ruled out. The relative expression of the three isoforms differs in different mammalian tissues: AKT1 is the predominant isoform in the majority of tissues, AKT2 is the predominant isoform in insulin-responsive tissues, and AKT3 is the predominant isoform in brain and testes. All 3 isoforms are expressed in human and mouse platelets (Yin et al. 2008; O'Brien et al. 2008). Note: all data in the pathway refer to AKT1, which is the most studied.", "literatureReference": [199317, {"dbId": 870256, "displayName": "The role of Akt3 in Platelet Activation", "title": "The role of Akt3 in Platelet Activation", "journal": "Arteriosclerosis, Thrombosis, and Vascular Biology", "pages": "e162", "volume": 28, "year": 2008, "className": "LiteratureReference", "schemaClass": "LiteratureReference"}, {"dbId": 870254, "displayName": "The role of Akt in the signaling pathway of the glycoprotein Ib-IX induced platelet activation", "title": "The role of Akt in the signaling pathway of the glycoprotein Ib-IX induced platelet activation", "journal": "Blood", "pages": "658-65", "pubMedIdentifier": 17914025, "volume": 111, "year": 2008, "url": "http://www.ncbi.nlm.nih.gov/pubmed/17914025", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}], "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "category": "binding", "input": [{"dbId": 179838, "displayName": "PI(3,4,5)P3 [plasma membrane]", "stId": "R-ALL-179838", "stIdVersion": "R-ALL-179838.4", "maxDepth": 1, "name": ["PI(3,4,5)P3", "PIP3", "1-phosphatidyl-1D-myo-inositol 3,4,5-trisphosphate", "Phosphatidylinositol-3,4,5-trisphosphate"], "crossReference": [{"dbId": 38118, "displayName": "COMPOUND:C05981", "databaseName": "COMPOUND", "identifier": "C05981", "url": "https://www.kegg.jp/entry/C05981", "className": "DatabaseIdentifier", "schemaClass": "DatabaseIdentifier"}], "positivelyRegulates": [{"dbId": 8951567, "di