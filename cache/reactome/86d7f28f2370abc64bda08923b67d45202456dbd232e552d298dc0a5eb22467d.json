axId": "10116", "abbreviation": "RNO", "className": "Species", "schemaClass": "Species"}, {"dbId": 48898, "displayName": "Bos taurus", "name": ["Bos taurus", "B. taurus", "Bt", "bovine", "cattle", "cow", "domestic cattle", "domestic cow"], "taxId": "9913", "abbreviation": "BTA", "className": "Species", "schemaClass": "Species"}], "isChimeric": true, "category": "binding", "className": "Reaction", "schemaClass": "Reaction"}], "literatureReference": [751038, 8982701], "reviewed": [{"dbId": 782850, "displayName": "D'Eustachio, P, 2010-05-21", "dateTime": "2010-05-22 03:10:45", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "revised": [{"dbId": 9012014, "displayName": "Varusai, Thawfeek, 2017-07-10", "dateTime": "2017-07-10 16:30:32", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 8982702, "displayName": "G alpha z (Lounsbury et al. 1991) and G alpha 12 (Kozasa & G...", "text": "G alpha z (Lounsbury et al. 1991) and G alpha 12 (Kozasa & Gilman, 1996) are excellent in vitro substrates for all three subtypes of protein kinase C (PKC). Activation of PKC in intact platelets by agents such as thrombin, thromboxane A2 (TXA2) analogues and phorbol esters leads to rapid and near-stoichiometric phosphorylation of G alpha z (Carlson et al. 1989). PKC can bind to G alpha z and facilitate its phosphorylation at Ser-27 (Lounsbury et al. 1993). This phosphorylation blocks the interaction of G alpha z with Gbeta:gamma suggesting that it is a regulatory mechanism for attenuating signalling by preventing subunit reassociation.", "literatureReference": [{"dbId": 751014, "displayName": "Protein kinase C phosphorylates G12 alpha and inhibits its interaction with G beta gamma", "title": "Protein kinase C phosphorylates G12 alpha and inhibits its interaction with G beta gamma", "journal": "J Biol Chem", "pages": "12562-7", "pubMedIdentifier": 8647866, "volume": 271, "year": 1996, "url": "http://www.ncbi.nlm.nih.gov/pubmed/8647866", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}, {"dbId": 751037, "displayName": "Thrombin and phorbol esters cause the selective phosphorylation of a G protein other than Gi in human platelets", "title": "Thrombin and phorbol esters cause the selective phosphorylation of a G protein other than Gi in human platelets", "journal": "J Biol Chem", "pages": "13298-305", "pubMedIdentifier": 2502548, "volume": 264, "year": 1989, "url": "http://www.ncbi.nlm.nih.gov/pubmed/2502548", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}, {"dbId": 751016, "displayName": "Analysis of Gz alpha by site-directed mutagenesis. Sites and specificity of protein kinase C-dependent phosphorylation", "title": "Analysis of Gz alpha by site-directed mutagenesis. Sites and specificity of protein kinase C-dependent phosphorylation", "journal": "J Biol Chem", "pages": "3494-8", "pubMedIdentifier": 8429024, "volume": 268, "year": 1993, "url": "http://www.ncbi.nlm.nih.gov/pubmed/8429024", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}], "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "isChimeric": false, "category": "binding", "input": [{"dbId": 392003, "displayName": "G-protein alpha (z):GTP [plasma membrane]", "stId": "R-HSA-392003", "stIdVersion": "R-HSA-392003.2", "maxDepth": 2, "name": ["G-protein alpha (z):GTP"], "speciesName": "Homo sapiens", "catalystActivities": [{"dbId": 392134, "displayName": "GTPase activity of G-protein alpha (z):GTP [plasma membrane]", "physicalEntity": 392003, "className": "CatalystActivity", "schemaClass": "CatalystActivity"}], "consumedByEvent": [8982703], "species": [48887], "inDisease": false, "schemaClass": "Complex", "className": "Complex"}, {"dbId": 804920, "displayName": "Protein k