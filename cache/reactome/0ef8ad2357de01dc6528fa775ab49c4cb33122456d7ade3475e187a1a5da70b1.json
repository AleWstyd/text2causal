liaris", "inferredFrom": [9731111], "species": [{"dbId": 49646, "displayName": "Canis familiaris", "name": ["Canis familiaris", "Canis lupus familiaris"], "taxId": "9615", "abbreviation": "CFA", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10214674, "displayName": "MAPK1 and MAPK3 phosphorylate SMAD2 and SMAD3", "stId": "R-RNO-9731111", "stIdVersion": "R-RNO-9731111.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["MAPK1 and MAPK3 phosphorylate SMAD2 and SMAD3"], "releaseDate": "2026-03-25", "speciesName": "Rattus norvegicus", "inferredFrom": [9731111], "species": [{"dbId": 48895, "displayName": "Rattus norvegicus", "name": ["Rattus norvegicus", "R. norvegicus", "Rn", "brown rat", "Norway rat"], "taxId": "10116", "abbreviation": "RNO", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10091668, "displayName": "MAPK1 and MAPK3 phosphorylate SMAD2 and SMAD3", "stId": "R-MMU-9731111", "stIdVersion": "R-MMU-9731111.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["MAPK1 and MAPK3 phosphorylate SMAD2 and SMAD3"], "releaseDate": "2026-03-25", "speciesName": "Mus musculus", "inferredFrom": [9731111], "species": [{"dbId": 48892, "displayName": "Mus musculus", "name": ["Mus musculus", "M. musculus", "Mm", "house mouse"], "taxId": "10090", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 9773670, "displayName": "Contreras, Osvaldo, 2022-05-02", "dateTime": "2022-05-02 00:00:00", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 9731131, "displayName": "MAPK1 (ERK2) and MAPK3 (ERK1) phosphorylate SMAD2 and SMAD3 ...", "text": "MAPK1 (ERK2) and MAPK3 (ERK1) phosphorylate SMAD2 and SMAD3 on conserved residues in the linker region, which connects the DNA-binding domain and the transcriptional activation domain. ERK-mediated phosphorylation leads to cytosolic retention of SMAD2 and SMAD3 and inhibits TGF-beta signaling (Kretzschmar et al. 1999). Potential ERK phosphorylation residues in SMAD2 are T220, S245, S250 and S255, and in SMAD3 they are T179, S213, S204 and S208 (Kretzschmar et al. 1999). The residue S250 in SMAD2 was shown to be phosphorylated by ERKs in several studies (Rostam et al. 2016, Talati et al. 2018). The corresponding site in SMAD3 is residue S208, and it was shown to be the most prominent ERK phosphorylation site (Matsuura et al. 2005). Only these two sites have been annotated as targets of ERK-mediated phosphorylation. Additional sites will be annotated as more information becomes available.<br><br>In addition to inhibitory phosphorylation of SMAD2 and SMAD3 by ERKs, an activating phosphorylation of SMAD2 on S8 by MAPK3 has also been reported (Funaba et al. 2002).", "literatureReference": [9731118, 9731123, 9731136, 9731142, {"dbId": 9731147, "displayName": "Modulation of Smad2-mediated signaling by extracellular signal-regulated kinase", "title": "Modulation of Smad2-mediated signaling by extracellular signal-regulated kinase", "journal": "J Biol Chem", "pages": "41361-8", "pubMedIdentifier": 12193595, "volume": 277, "year": 2002, "url": "http://www.ncbi.nlm.nih.gov/pubmed/12193595", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}], "className": "Summation", "schemaClass": "Summation"}], "negativePrecedingEvent": [{"dbId": 9754410, "displayName": "Futile Cycle: Dephosphorylated SMAD2/3 translocates to the cytosol", "precedingEvent": [9731111], "className": "NegativePrecedingEvent", "schemaClass": "NegativePrecedingEvent"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "R