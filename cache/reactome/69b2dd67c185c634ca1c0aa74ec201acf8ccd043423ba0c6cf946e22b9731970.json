peciesName": "Rattus norvegicus", "inferredFrom": [2730892], "species": [{"dbId": 48895, "displayName": "Rattus norvegicus", "name": ["Rattus norvegicus", "R. norvegicus", "Rn", "brown rat", "Norway rat"], "taxId": "10116", "abbreviation": "RNO", "className": "Species", "schemaClass": "Species"}], "category": "binding", "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10046363, "displayName": "Recruitment of VAV to p-SLP-76", "stId": "R-MMU-2730892", "stIdVersion": "R-MMU-2730892.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["Recruitment of VAV to p-SLP-76"], "releaseDate": "2026-03-25", "speciesName": "Mus musculus", "inferredFrom": [2730892], "species": [{"dbId": 48892, "displayName": "Mus musculus", "name": ["Mus musculus", "M. musculus", "Mm", "house mouse"], "taxId": "10090", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "category": "binding", "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 3139040, "displayName": "Roncagalli, Romain, 2013-02-13", "dateTime": "2013-02-13 21:56:18", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 2685563, "displayName": "VAV an activator of RAC-GTPases, is redistributed to plasma ...", "text": "VAV an activator of RAC-GTPases, is redistributed to plasma membrane and is phosphorylated following engagement of FCERI. Phosphorylated SLP-76 tyrosines Y113 and Y128 (112Y and 128Y in mouse) provide binding sites for the SH2 domains of VAV. The binding of VAV to these phosphotyrosine residues may link SLP-76 to the Jun amino-terminal kinase (JNK) pathway and the actin cytoskeleton (Kettner et al. 2003).<br>In addition to its known role as guanine nucleotide exchange factor (GEF), VAV also modulates cytokine production in mast cells. VAV1-deficient bone marrow-derived mast cells exhibited reduced degranulation and cytokine production and calcium release in addition of reduced activation of c-Jun NH2-terminal kinase 1 (JNK1), although tyrosine phosphorylation of FCERI, SYK and LAT was normal (Manetz et al. 2001, Arudchandran et al. 2000, Song et al. 1999).", "literatureReference": [2685200, {"dbId": 2424347, "displayName": "Btk is a positive regulator in the TREM-1/DAP12 signaling pathway", "title": "Btk is a positive regulator in the TREM-1/DAP12 signaling pathway", "journal": "Blood", "pages": "936-45", "pubMedIdentifier": 21659545, "volume": 118, "year": 2011, "url": "http://www.ncbi.nlm.nih.gov/pubmed/21659545", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}, {"dbId": 2424362, "displayName": "The Rho family guanine nucleotide exchange factor Vav-2 regulates the development of cell-mediated cytotoxicity", "title": "The Rho family guanine nucleotide exchange factor Vav-2 regulates the development of cell-mediated cytotoxicity", "journal": "J. Exp. Med.", "pages": "381-92", "pubMedIdentifier": 10934226, "volume": 192, "year": 2000, "url": "http://www.ncbi.nlm.nih.gov/pubmed/10934226", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}, {"dbId": 3448721, "displayName": "The Src homology 2 domain of Vav is required for its compartmentation to the plasma membrane and activation of c-Jun NH(2)-terminal kinase 1", "title": "The Src homology 2 domain of Vav is required for its compartmentation to the plasma membrane and activation of c-Jun NH(2)-terminal kinase 1", "journal": "J. Exp. Med.", "pages": "47-60", "pubMedIdentifier": 10620604, "volume": 191, "year": 2000, "url": "http://www.ncbi.nlm.nih.gov/pubmed/10620604", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}, {"dbId": 2424401, "displayName": "Structural requirements of SLP-76 in signaling via the high-affinity immunoglobulin E receptor (Fc epsilon RI) in mast cells", "title": "Structural requirements of SLP-76 in signaling via the high-affinity immunoglobulin E receptor (Fc epsilon RI) in mast cells", "journal": "Mol. Cell. Biol.", "pages": "2395-406", "pubMedIdentifier": 12640123, "volume": 23, "year": 2003, "url": "http://www.ncbi.nlm.nih.gov/pubmed/12640123", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}], "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "isChimeric": false, "category": "binding", "input": [{"dbId": 430172, "displayName": "VAV1,2,3 [cytosol]", "stId": "R-HSA-430172", "stIdVersion": "R-HSA-430172.1", "maxDepth": 2, "name": ["VAV1,2,3", "VAV1,VAV2,VAV3"], "speciesName": "Homo sapiens", "consumedByEvent": [2730892], "species": [48887], "className": "Set", "inDisease": false, "schemaClass": "DefinedSet"}, {"dbId": 2424460, "displayName": "p-5Y-LAT:p-SHC1:GRB2:SOS1:GADS:p-Y113,Y128,Y145-SLP-76:PLCG [plasma membrane]", "stId": "R-HSA-2424460", "stIdVersion": "R-HSA-2424460.1", "maxDepth": 5, "name": ["p-5Y-LAT:p-SHC1:GRB2:SOS1:GADS:p-Y113,Y128,Y145-SLP-76:PLCG"], "speciesName": "Homo sapiens", "consumedByEvent": [2730892], "isChimeric": false, "species": [48887], "inDisease": false, "schemaClass": "Complex", "className": "Complex"}], "output": [{"dbId": 2685668, "displayName": "p-5Y-LAT:p-SHC1:GRB2:SOS1:GADS:p-Y113,Y128,Y145-SLP-76:PLCG1:VAV [plasma membrane]", "stId": "R-HSA-2685668", "stIdVersion": "R-HSA-2685668.1", "maxDepth": 6, "name": ["p-5Y-LAT:p-SHC1:GRB2:SOS1:GADS:p-Y113,Y128,Y145-SLP-76:PLCG1:VAV"], "speciesName": "Homo sapiens", "producedByEvent": [2730892], "isChimeric": false, "species": [48887], "inDisease": false, "schemaClass": "Complex", "className": "Complex"}], "className": "Reaction", "schemaClass": "Reaction"}