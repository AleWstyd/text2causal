category": "binding", "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 3139040, "displayName": "Roncagalli, Romain, 2013-02-13", "dateTime": "2013-02-13 21:56:18", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 2685552, "displayName": "TRAF6 is a ubiquitin ligase that plays a central role in the...", "text": "TRAF6 is a ubiquitin ligase that plays a central role in the IKK-dependent canonical NF-kB pathway. It is recruited to the CBM complex by binding to MALT1. The MALT1 C-terminal Ig domain and extension contain two binding motifs for TRAF6 (Noels et al 2007). After oligomerzation TRAF6, together with Ubc13/Uev1A, activates TAK1 and IKK. It also acts as an E3 ligase for MALT1 and mediates lysine 63-linked ubiquitination (Oeckinghaus et al. 2007).", "literatureReference": [2685021, {"dbId": 2685435, "displayName": "A Novel TRAF6 binding site in MALT1 defines distinct mechanisms of NF-kappaB activation by API2middle dotMALT1 fusions", "title": "A Novel TRAF6 binding site in MALT1 defines distinct mechanisms of NF-kappaB activation by API2middle dotMALT1 fusions", "journal": "J. Biol. Chem.", "pages": "10180-9", "pubMedIdentifier": 17287209, "volume": 282, "year": 2007, "url": "http://www.ncbi.nlm.nih.gov/pubmed/17287209", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}], "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "isChimeric": false, "category": "binding", "input": [{"dbId": 2685671, "displayName": "DAG:p-5Y-PKC-theta:CBM oligomer [plasma membrane]", "stId": "R-HSA-2685671", "stIdVersion": "R-HSA-2685671.1", "maxDepth": 4, "name": ["DAG:p-5Y-PKC-theta:CBM oligomer"], "speciesName": "Homo sapiens", "consumedByEvent": [2730864], "isChimeric": false, "species": [488