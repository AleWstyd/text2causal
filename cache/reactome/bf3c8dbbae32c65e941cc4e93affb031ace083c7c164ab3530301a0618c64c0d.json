: "2008-09-16 10:21:39", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 372675, "displayName": "BCAR1 (breast cancer anti-estrogen resistance protein1, also...", "text": "BCAR1 (breast cancer anti-estrogen resistance protein1, also known as Crk-associated substrate (Cas) or p130Cas) is an adaptor protein that promotes protein-protein interactions, leading to the multiprotein complexes. The interaction of ?BCAR1/p130Cas with other proteins modulates cell motility, survial and proliferation. BCAR1/P130Cas is one of the main phosphorylation targets of the PTK2/SRC complex. The BCAR1 SH3 domain binds to PR1 and PR2 (\u2018PxxP\u2019) domains in the PTK2 C-terminal domain.", "literatureReference": [354182], "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "updateTrackers": [{"dbId": 9778644, "displayName": "Update Tracker - [Reaction:372705] Recruitment of BCAR1 to PTK2 complex - v68:[modifyText]", "action": ["modifyText"], "updatedInstance": [372705], "className": "UpdateTracker", "schemaClass": "UpdateTracker"}, {"dbId": 9782695, "displayName": "Update Tracker - [Reaction:372705] Recruitment of BCAR1 to PTK2 complex - v59:[modifyText]", "action": ["modifyText"], "updatedInstance": [372705], "className": "UpdateTracker", "schemaClass": "UpdateTracker"}, {"dbId": 9784642, "displayName": "Update Tracker - [Reaction:372705] Recruitment of BCAR1 to PTK2 complex - v53:[addLiteratureReference]", "action": ["addLiteratureReference"], "updatedInstance": [372705], "className": "UpdateTracker", "schemaClass": "UpdateTracker"}, {"dbId": 9789599, "displayName": "Update Tracker - [Reaction:372705] Recruitment of BCAR1 to PTK2 complex - v37:[modifyText]", "action": ["modifyText"], "updatedInstance": [372705], "className": "UpdateTracker",