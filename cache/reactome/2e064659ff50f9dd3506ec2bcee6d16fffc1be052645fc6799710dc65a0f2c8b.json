"name": ["Mus musculus", "M. musculus", "Mm", "house mouse"], "taxId": "10090", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "category": "binding", "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 9686656, "displayName": "Gavathiotis, Evripidis, 2020-05-04", "dateTime": "2020-05-04 18:19:23", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 9635742, "displayName": "PTPN7 (HePTP) protein tyrosine phosphatase binds to MAPK1 (E...", "text": "PTPN7 (HePTP) protein tyrosine phosphatase binds to MAPK1 (ERK2) (Saxena et al. 1999, Munoz et al. 2003) and MAPK3 (ERK1) (Oh-hora et al. 1999, Munoz et al. 2003). The interaction of PTPN7 with MAPKs involves the KIM (kinase-interaction motif) of PTPN7.<br>PTPN7 may have a preference for ERK2 over ERK1 (Pettiford and Herbst 2000). ERK1 used in the study by Oh-hora et al. 1999 was likely human, but it is not certain. In the study by Munoz et al. 2003, interaction of PTPN7 with rat ERK1 was demonstrated, but the origin of PTPN7 was not specified. ", "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "isChimeric": false, "category": "binding", "input": [{"dbId": 9635737, "displayName": "PTPN7 [cytosol]", "stId": "R-HSA-9635737", "stIdVersion": "R-HSA-9635737.1", "maxDepth": 1, "name": ["PTPN7", "Tyrosine-protein phosphatase non-receptor type 7", "HEPTP", "Hematopoietic protein-tyrosine phosphatase"], "speciesName": "Homo sapiens", "consumedByEvent": [9635743], "species": 48887, "endCoordinate": 360, "referenceType": "ReferenceGeneProduct", "startCoordinate": 1, "className": "Protein", "inDisease": false, "schemaClass": "EntityWithAccessionedSequence"}, {"dbId": 1268261, "displayName": "p-T,Y MAPK dimers [cytosol]", "stId": "R-HSA-1268261