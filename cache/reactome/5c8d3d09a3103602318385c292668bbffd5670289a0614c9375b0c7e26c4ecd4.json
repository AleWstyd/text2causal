sName": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10280733, "displayName": "Phosphorylation of IKK-beta by TAK1", "stId": "R-CFA-2730876", "stIdVersion": "R-CFA-2730876.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["Phosphorylation of IKK-beta by TAK1"], "releaseDate": "2026-03-25", "speciesName": "Canis familiaris", "inferredFrom": [2730876], "species": [{"dbId": 49646, "displayName": "Canis familiaris", "name": ["Canis familiaris", "Canis lupus familiaris"], "taxId": "9615", "abbreviation": "CFA", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10168083, "displayName": "Phosphorylation of IKK-beta by TAK1", "stId": "R-RNO-2730876", "stIdVersion": "R-RNO-2730876.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["Phosphorylation of IKK-beta by TAK1"], "releaseDate": "2026-03-25", "speciesName": "Rattus norvegicus", "inferredFrom": [2730876], "species": [{"dbId": 48895, "displayName": "Rattus norvegicus", "name": ["Rattus norvegicus", "R. norvegicus", "Rn", "brown rat", "Norway rat"], "taxId": "10116", "abbreviation": "RNO", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10046348, "displayName": "Phosphorylation of IKK-beta by TAK1", "stId": "R-MMU-2730876", "stIdVersion": "R-MMU-2730876.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["Phosphorylation of IKK-beta by TAK1"], "releaseDate": "2026-03-25", "speciesName": "Mus musculus", "inferredFrom": [2730876], "species": [{"dbId": 48892, "displayName": "Mus musculus", "name": ["Mus musculus", "M. musculus", "Mm", "house mouse"], "taxId": "10090", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 3139040, "displayName": "Roncagalli, Romain, 2013-02-13", "dateTime": "2013-02-13 21:56:18", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 2685566, "displayName": "In humans, the IkB kinase (IKK) complex serves as the master...", "text": "In humans, the IkB kinase (IKK) complex serves as the master regulator for the activation of NF-kB by various stimuli. It contains two catalytic subunits, IKK alpha and IKK beta, and a regulatory subunit, IKKgamma/NEMO. The activation of IKK complex is dependent on the phosphorylation of IKK alpha/beta at its activation loop and the K63-linked ubiquitination of NEMO. This basic trimolecular complex is referred to as the IKK complex. <br>IKK subunits have a N-term kinase domain a leucine zipper (LZ) motifs, a helix-loop-helix (HLH) and a C-ter NEMO binding domain (NBD). IKK catalytic subunits are dimerized through their LZ motifs.  IKK beta is the major IKK catalytic subunit for NF-kB activation. Activated TAK1 phosphorylate IKK beta on S177 and S181 (S176 and S180 in IKK alpha) in the activation loop and thus activate the IKK kinase activity, leading to the IkB alpha phosphorylation and NF-kB activation.", "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "category": "transition", "catalystActivity": [{"dbId": 2730866, "displayName": "protein serine/threonine kinase activity of DAG:p-5Y-PKC-theta:CBM oligomer:oligo-K63-poly Ub-TRAF6:activated TAK1 complex [plasma membrane]", "catalyzedEvent": [2730876], "physicalEntity": {"dbId": 2685709, "displayName": "DAG:p-5Y-PKC-theta:CBM oligomer:oligo-K63-poly Ub-TRAF6:activated TAK1 complex [plasma membrane]", "stId": "R-HSA-2685709", "stIdVersion": "R-HSA-2685709.1", "maxDepth": 5, "name": ["DAG:p-5Y-PKC-theta:C