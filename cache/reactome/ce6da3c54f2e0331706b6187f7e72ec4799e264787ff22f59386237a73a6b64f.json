splayName": "Rattus norvegicus", "name": ["Rattus norvegicus", "R. norvegicus", "Rn", "brown rat", "Norway rat"], "taxId": "10116", "abbreviation": "RNO", "className": "Species", "schemaClass": "Species"}], "category": "binding", "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10079213, "displayName": "Cleaved fibrinogen products bind TLR4:LY96", "stId": "R-MMU-8870678", "stIdVersion": "R-MMU-8870678.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["Cleaved fibrinogen products bind TLR4:LY96"], "releaseDate": "2026-03-25", "speciesName": "Mus musculus", "inferredFrom": [8870678], "species": [{"dbId": 48892, "displayName": "Mus musculus", "name": ["Mus musculus", "M. musculus", "Mm", "house mouse"], "taxId": "10090", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "category": "binding", "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 8870806, "displayName": "Granucci, Francesca, Zanoni, Ivan", "dateTime": "2016-05-12 04:10:26", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 8870682, "displayName": "Fibrinogen, in addition to its role in coagulation, is also ...", "text": "Fibrinogen, in addition to its role in coagulation, is also an acute phase protein of inflammation which can induce a cytokine production acting as an endogenous ligand for toll-like receptor 4 (TLR4) expressed on cells including macrophages and airway epithelial cells (Millien VO et al., 2013; Kuhns DB et al., 2007; Smiley ST et al., 2001). In human macrophages fibrinogen stimulated interleukin IL6 expression and extracellular signal-related kinase (ERK) phosphorylation ((Hodgkinson CP et al., 2008). In human embryonic kidney 293 (HEK293)-CD14-MD2 cells expressing TLR4, fibrinogen induced robust phosphorylation of ERK1, p38alpha and JNK and activated transcription factors NFkappaB, Elk1 and AP1 (Hodgkinson CP et al., 2008). Moreover, proteinases, such as thrombin, can cleave fibrinogen. In mice, exposure to endogenous or exogenous proteinases lead to hyperactivation of an antifungal pathway and lead to allergic airway inflammation through activation of TLR4-dependent signaling pathway by fibrinogen cleaved products (Millien VO et al., 2013)", "literatureReference": [181287, {"dbId": 8870814, "displayName": "Induction of human monocyte interleukin (IL)-8 by fibrinogen through the toll-like receptor pathway", "title": "Induction of human monocyte interleukin (IL)-8 by fibrinogen through the toll-like receptor pathway", "journal": "Inflammation", "pages": "178-88", "pubMedIdentifier": 17624583, "volume": 30, "year": 2007, "url": "http://www.ncbi.nlm.nih.gov/pubmed/17624583", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}, {"dbId": 8870804, "displayName": "Cleavage of fibrinogen by proteinases elicits allergic responses through Toll-like receptor 4", "title": "Cleavage of fibrinogen by proteinases elicits allergic responses through Toll-like receptor 4", "journal": "Science", "pages": "792-6", "pubMedIdentifier": 23950537, "volume": 341, "year": 2013, "url": "http://www.ncbi.nlm.nih.gov/pubmed/23950537", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}], "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "isChimeric": false, "category": "binding", "input": [{"dbId": 8870680, "displayName": "FGA, FGB, FGG [extracellular region]", "stId": "R-HSA-8870680", "stIdVersion": "R-HSA-8870680.2", "maxDepth": 2, "name": ["FGA, FGB, FGG", "Fibrinogen cleavage products"], "speciesName": "Homo sapiens", "consumedByEvent": [8870678], "species": [48887], "className": "Set", "inDisease": false, "schemaClass": "DefinedSet"}, {"dbId": 166050, "displayName": "TLR4:LY96 [plasma membrane]", "stId": "R-