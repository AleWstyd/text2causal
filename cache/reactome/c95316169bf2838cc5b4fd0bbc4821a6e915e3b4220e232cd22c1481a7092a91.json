eam of all FGFR receptors upon stimulation with FGFs.", "literatureReference": [191025, {"dbId": 191524, "displayName": "Activation of phospholipase C gamma by PI 3-kinase-induced PH domain-mediated membrane targeting", "title": "Activation of phospholipase C gamma by PI 3-kinase-induced PH domain-mediated membrane targeting", "journal": "EMBO J", "pages": "414-22", "pubMedIdentifier": 9430633, "volume": 17, "year": 1998, "url": "http://www.ncbi.nlm.nih.gov/pubmed/9430633", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}], "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "deleted": [{"dbId": 5655557, "displayName": "Deletion of instance: 190896", "replacementInstances": [5654167], "deletedInstanceDbId": [190896], "className": "Deleted", "schemaClass": "Deleted"}], "category": "binding", "input": [{"dbId": 179838, "displayName": "PI(3,4,5)P3 [plasma membrane]", "stId": "R-ALL-179838", "stIdVersion": "R-ALL-179838.4", "maxDepth": 1, "name": ["PI(3,4,5)P3", "PIP3", "1-phosphatidyl-1D-myo-inositol 3,4,5-trisphosphate", "Phosphatidylinositol-3,4,5-trisphosphate"], "crossReference": [{"dbId": 38118, "displayName": "COMPOUND:C05981", "databaseName": "COMPOUND", "identifier": "C05981", "url": "https://www.kegg.jp/entry/C05981", "className": "DatabaseIdentifier", "schemaClass": "DatabaseIdentifier"}], "positivelyRegulates": [{"dbId": 8951567, "displayName": "Positive regulation by 'PI(3,4,5)P3 [plasma membrane]'", "stId": "R-HSA-8951567", "stIdVersion": "R-HSA-8951567.1", "regulator": 179838, "schemaClass": "PositiveRegulation", "className": "PositiveRegulation"}], "consumedByEvent": [5654167], "referenceType": "ReferenceMolecule", "className": "Chemical Compound", "inDisease": false, "schemaClass": "SimpleEntity"}, {"dbId": 5654170, "displayName": "Activated F