 and ERK1. The contribution of most of these modified proteins to antiviral activity is unclear because the fate of the vast majority of ISGylated target proteins is unknown.", "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "previousReviewStatus": {"dbId": 9821385, "displayName": "four stars", "definition": "structure upated after externally reviewed and then internally reviewed", "name": ["four stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "updateTrackers": [{"dbId": 9971879, "displayName": "Update Tracker - [Reaction:1169406] ISGylation of host proteins - v95:[addInput, addOutput]", "action": ["addInput", "addOutput"], "updatedInstance": [1169406], "className": "UpdateTracker", "schemaClass": "UpdateTracker"}], "isChimeric": false, "category": "transition", "catalystActivity": [{"dbId": 1169401, "displayName": "ISG15 ligase activity of ISG15:UBCH8:ISG15 E3 ligase [cytosol]", "catalyzedEvent": [1169406], "physicalEntity": {"dbId": 1169383, "displayName": "ISG15:UBCH8:ISG15 E3 ligase [cytosol]", "stId": "R-HSA-1169383", "stIdVersion": "R-HSA-1169383.1", "maxDepth": 3, "name": ["ISG15:UBCH8:ISG15 E3 ligase"], "speciesName": "Homo sapiens", "catalystActivities": [1169401], "consumedByEvent": [1169406], "isChimeric": false, "species": [48887], "inDisease": false, "schemaClass": "Complex", "className": "Complex"}, "className": "CatalystActivity", "schemaClass": "CatalystActivity"}], "input": [1169383, {"dbId": 1169379, "displayName": "ISG15 targets [cytosol]", "stId": "R-HSA-1169379", "stIdVersion": "R-HSA-1169379.3", "maxDepth": 3, "name": ["ISG15 targets"], "speciesName": "Homo sapiens", "consumedByEvent": [1169406], "species": [48887], "className": "Set", "inDisease": false, "schemaClass": "CandidateSet"}], "output": [{"dbId": 1169387, "displayName": "I