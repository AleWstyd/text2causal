axDepth": 1, "name": ["MAPK12 phosphorylates PTPN3"], "releaseDate": "2026-03-25", "speciesName": "Rattus norvegicus", "inferredFrom": [8868118], "species": [{"dbId": 48895, "displayName": "Rattus norvegicus", "name": ["Rattus norvegicus", "R. norvegicus", "Rn", "brown rat", "Norway rat"], "taxId": "10116", "abbreviation": "RNO", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10078389, "displayName": "MAPK12 phosphorylates PTPN3", "stId": "R-MMU-8868118", "stIdVersion": "R-MMU-8868118.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["MAPK12 phosphorylates PTPN3"], "releaseDate": "2026-03-25", "speciesName": "Mus musculus", "inferredFrom": [8868118], "species": [{"dbId": 48892, "displayName": "Mus musculus", "name": ["Mus musculus", "M. musculus", "Mm", "house mouse"], "taxId": "10090", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 9686656, "displayName": "Gavathiotis, Evripidis, 2020-05-04", "dateTime": "2020-05-04 18:19:23", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 8868117, "displayName": "PTPN3 has been shown to bind to phosphorylated MAPK12 and pr...", "text": "PTPN3 has been shown to bind to phosphorylated MAPK12 and promote its dephosphorylation, and this interaction is correlated with increased oncogenic signaling through RAS (Hou et al, 2010; Tang et al, 2005; Chen et al, 2014 ).  Although the mechanism for this PTPN3 and MAPK12-dependent activation of RAS signaling is not known, dephosphorylation of MAPK12 allows the recovery of larger amounts of MAPK12 from a complex with ERK proteins, suggesting a possible mechanism. A more recent study, however, has found that PTPN3 is itself phosphorylated in a MAPK12-dependent fashion upon binding with phospho-MAPK12