not determined. According to some authors, NGF does not induce any significant activation of MAPKAPK2 activity in PC12 cells. Potential p38 signaling effectors include transcription factors, such as cAMP-response element-binding protein and MEF2, cytoskeleton modulators, and a number of protein kinases. After activation, MAPKAP kinase 2 and 3 move to the nucleus.", "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "deleted": [{"dbId": 8875153, "displayName": "Deletion of instance: 5218837", "curatorComment": "This duplicate event is replaced with 187688 event instance", "replacementInstances": [187688], "deletedInstanceDbId": [5218837], "className": "Deleted", "schemaClass": "Deleted"}], "updateTrackers": [{"dbId": 9783093, "displayName": "Update Tracker - [Reaction:187688] p38 MAPK phosphorylates MAPKAPK2, MAPKAPK3 - v57:[modifyText]", "action": ["modifyText"], "updatedInstance": [187688], "className": "UpdateTracker", "schemaClass": "UpdateTracker"}], "category": "transition", "catalystActivity": [{"dbId": 187724, "displayName": "protein serine/threonine kinase activity of Phospho-MAP kinase p38 (Mg2+ cofactor) [cytosol]", "catalyzedEvent": [187688], "physicalEntity": {"dbId": 170993, "displayName": "Phospho-MAP kinase p38 (Mg2+ cofactor) [cytosol]", "stId": "R-HSA-170993", "stIdVersion": "R-HSA-170993.1", "maxDepth": 3, "name": ["Phospho-MAP kinase p38 (Mg2+ cofactor)"], "speciesName": "Homo sapiens", "catalystActivities": [187724], "inDisease": false, "schemaClass": "Complex", "className": "Complex"}, "className": "CatalystActivity", "schemaClass": "CatalystActivity"}], "input": [{"dbId": 113592, "displayName": "ATP [cytosol]", "stId": "R-ALL-113592", "stIdVersion": "R-ALL-113592.5", "maxDepth": 1, "name": ["ATP", "Adenosine 5'-triphosphate", "ATP(4-)"], "crossReference": [{