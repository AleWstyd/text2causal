"releaseDate": "2026-03-25", "speciesName": "Rattus norvegicus", "inferredFrom": [8867654], "species": [{"dbId": 48895, "displayName": "Rattus norvegicus", "name": ["Rattus norvegicus", "R. norvegicus", "Rn", "brown rat", "Norway rat"], "taxId": "10116", "abbreviation": "RNO", "className": "Species", "schemaClass": "Species"}], "category": "binding", "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10078254, "displayName": "PTPN3 binds p-T183,Y185 MAPK12", "stId": "R-MMU-8867654", "stIdVersion": "R-MMU-8867654.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["PTPN3 binds p-T183,Y185 MAPK12"], "releaseDate": "2026-03-25", "speciesName": "Mus musculus", "inferredFrom": [8867654], "species": [{"dbId": 48892, "displayName": "Mus musculus", "name": ["Mus musculus", "M. musculus", "Mm", "house mouse"], "taxId": "10090", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "category": "binding", "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 9686656, "displayName": "Gavathiotis, Evripidis, 2020-05-04", "dateTime": "2020-05-04 18:19:23", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 8867653, "displayName": "PTPN3 is a protein phosphatase that dephosphorylates MAPK12,...", "text": "PTPN3 is a protein phosphatase that dephosphorylates MAPK12, also known as p38 gamma. Phosphorylation of the p38 family of MAPK is associated with suppression of RAS signaling, and consistent with this, binding and dephosphorylation of MAPK12 by PTPN3 promotes RAS-induced transformation (Tang et al, 2005; Hou et al, 2010; Chen et al, 2014).  <br>Dephosphorylation is promoted by a direct binding between phosphorylated MAPK12 and PTPN3, mediated by an interaction between the PTPN3 PDZ domain and the isoform-specific ETPL domain of MAPK12.  Binding of PTPN3 and phosphorylated MAPK12 relieves an autoinhibitory conformation of the phosphatase and promotes MAPK12 dephosphorylation (Hou et al, 2010; Chen et al, 2014).  How dephosphorylated MAPK12 promotes RAS signaling remains to be elucidated.", "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "isChimeric": false, "category": "binding", "input": [{"dbId": 171021, "displayName": "p-T183,Y185-MAPK12 [cytosol]", "stId": "R-HSA-171021", "stIdVersion": "R-HSA-171021.1", "maxDepth": 1, "name": ["p-T183,Y185-MAPK12", "Phospho-MAP kinase p38 gamma", "P-MAPK12"], "speciesName": "Homo sapiens", "consumedByEvent": [8867654], "species": 48887, "endCoordinate": 367, "referenceType": "ReferenceGeneProduct", "startCoordinate": 1, "className": "Protein", "inDisease": false, "schemaClass": "EntityWithAccessionedSequence"}, {"dbId": 8867650, "displayName": "PTPN3 [cytosol]", "stId": "R-HSA-8867650", "stIdVersion": "R-HSA-8867650.1", "maxDepth": 1, "name": ["PTPN3", "Tyrosine-protein phosphatase non-receptor type 3 ecNumber3.1.3.48/ecNumber", "PTN3_HUMAN"], "speciesName": "Homo sapiens", "consumedByEvent": [8867654], "species": 48887, "endCoordinate": 913, "referenceType": "ReferenceGeneProduct", "startCoordinate": 1, "className": "Protein", "inDisease": false, "schemaClass": "EntityWithAccessionedSequence"}], "output": [{"dbId": 8867651, "displayName": "PTPN3:p-T183,Y185-MAPK12 [cytosol]", "stId": "R-HSA-8867651", "stIdVersion": "R-HSA-8867651.1", "maxDepth": 2, "name": ["PTPN3:p-T183,Y185-MAPK12"], "speciesName": "Homo sapiens", "catalystActivities": [{"dbId": 8868115, "displayName": "protein serine/threonine kinase activity of PTPN3:p-T183,Y185-MAPK12 [cytosol]", "physicalEntity": 8867651, "className": "CatalystActivity", "schemaClass": "CatalystActivity"}, {"dbId": 8867657, "displayName": "protein tyrosine phosphatase activity of PTPN3:p-T183,Y185-MAPK12 [cytosol]", "physicalEntity": 8867651, "class