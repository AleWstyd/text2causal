Name": "Mus musculus", "name": ["Mus musculus", "M. musculus", "Mm", "house mouse"], "taxId": "10090", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "category": "transition", "regulatedBy": [{"dbId": 10055925, "displayName": "Positive regulation by 'ATP2B4:NOS1 [plasma membrane]'", "regulatedEntity": [10055927], "schemaClass": "PositiveRegulation", "className": "PositiveRegulation"}], "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 6809173, "displayName": "Colotti, Gianni, 2015-11-09", "dateTime": "2015-11-09 18:48:09", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 5617187, "displayName": "Cardiac muscle phospholamban (PLN aka PLB) modulates cardiac...", "text": "Cardiac muscle phospholamban (PLN aka PLB) modulates cardiac contractility by inhibiting the sarcoplasmic reticulum calcium pump (ATP2A2 aka SERCA). This process is dynamically regulated by beta-adrenergic stimulation and phosphorylation of PLN. Protein kinase A (PRKACA) is able to phosphorylate PLN at serine 16, relieving its inhibition of ATP2A2 and modulating cardiac contractility (Glaves et al. 2011, Ceholski et al. 2012). The ATP2B4:NOS1 complex, via cAMP, increases PRKACA activity, thereby regulating the response of the heart to beta-adrenergic agonists.", "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "isChimeric": false, "category": "transition", "catalystActivity": [{"dbId": 914181, "displayName": "cAMP-dependent protein kinase activity of PRKACA [cytosol]", "catalyzedEvent": [5617182], "physicalEntity": {"dbId": 57844, "displayName": "PRKACA [cytosol]", "stId": "R-HSA-57844", "stIdVersion": "R-HSA-57844.1", "maxDepth": 1, "name": ["PRKACA", "PKA C-alpha", "cAMP-dependent protein kinase, alpha-