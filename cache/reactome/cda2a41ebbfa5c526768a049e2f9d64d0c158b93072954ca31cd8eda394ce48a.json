ass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10267484, "displayName": "Synthesis of PIP3 from PIP2 by PI3K", "stId": "R-CFA-1433514", "stIdVersion": "R-CFA-1433514.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["Synthesis of PIP3 from PIP2 by PI3K"], "releaseDate": "2026-03-25", "speciesName": "Canis familiaris", "inferredFrom": [1433514], "species": [{"dbId": 49646, "displayName": "Canis familiaris", "name": ["Canis familiaris", "Canis lupus familiaris"], "taxId": "9615", "abbreviation": "CFA", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10153417, "displayName": "Synthesis of PIP3 from PIP2 by PI3K", "stId": "R-RNO-1433514", "stIdVersion": "R-RNO-1433514.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["Synthesis of PIP3 from PIP2 by PI3K"], "releaseDate": "2026-03-25", "speciesName": "Rattus norvegicus", "inferredFrom": [1433514], "species": [{"dbId": 48895, "displayName": "Rattus norvegicus", "name": ["Rattus norvegicus", "R. norvegicus", "Rn", "brown rat", "Norway rat"], "taxId": "10116", "abbreviation": "RNO", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10030610, "displayName": "Synthesis of PIP3 from PIP2 by PI3K", "stId": "R-MMU-1433514", "stIdVersion": "R-MMU-1433514.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["Synthesis of PIP3 from PIP2 by PI3K"], "releaseDate": "2026-03-25", "speciesName": "Mus musculus", "inferredFrom": [1433514], "species": [{"dbId": 48892, "displayName": "Mus musculus", "name": ["Mus musculus", "M. musculus", "Mm", "house mouse"], "taxId": "10090", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 1500883, "displayName": "R\u00f6nnstrand, Lars, 2011-08-22", "dateTime": "2011-08-22 20:47:45", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 1433464, "displayName": "PI3 kinases catalyze the production of phosphatidylinositol-...", "text": "PI3 kinases catalyze the production of phosphatidylinositol-3, 4, 5-triphosphate (PIP3) by phosphorylating phosphatidylinositol-4, 5-bisphosphate (PIP2). PIP3 bound to the inner lipid bilayer of the plasma membrane promotes the recruitment and activation of AKT. Active AKT subsequently phosphorylates the pro-apoptotic factor BAD at Ser136. Phosphorylated BAD binds 14-3-3 proteins, sequestering BAD from interaction with the anti-apoptotic molecule BCL-XL and leaving BCL-Xl free to inhibit BAX-triggered apoptosis. In this way, AKT-mediated BAD phosphorylation promotes cell survival. The alternative route for c-Kit mediated survival is through AKT-mediated phosphorylation and inactivation of the forkhead transcription factor (FoxO3a) (Engstrom et al, 2003; Lennartson et al, 2005).", "literatureReference": [1433408, 1433283, {"dbId": 1433449, "displayName": "Inactivation of the forkhead transcription factor FoxO3 is essential for PKB-mediated survival of hematopoietic progenitor cells by kit ligand", "title": "Inactivation of the forkhead transcription factor FoxO3 is essential for PKB-mediated survival of hematopoietic progenitor cells by kit ligand", "journal": "Exp Hematol", "pages": "316-23", "pubMedIdentifier": 12691919, "volume": 31, "year": 2003, "url": "http://www.ncbi.nlm.nih.gov/pubmed/12691919", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}, {"dbId": 1433431, "displayName": "The kit receptor promotes cell survival via activation of PI 3-kinase and subsequent Akt-mediated phosphorylation of Bad on Ser136", "title": "The kit receptor promotes cell survival via activation of PI 3-kinase and subsequent Akt-mediated phosphorylation of Bad on Ser136", "journal": "Curr Biol", "pages": "779-82", "pubMedIdentifier": 9651683, "volume": 8, "year": 1998, "url": "http://www.ncbi.nlm.nih.gov/pubmed/9651683", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}], "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "updateTrackers": [{"dbId": 9776954, "displayName": "Update Tracker - [Reaction:1433514] Synthesis of PIP3 from PIP2 by PI3K - v73:[modifyText]", "action": ["modifyText"], "updatedInstance": [1433514], "className": "UpdateTracker", "schemaClass": "UpdateTracker"}, {"dbId": 9777281, "displayName": "Update Tracker - [Reaction:1433514] Synthesis of PIP3 from PIP2 by PI3K - v72:[modifyText]", "action": ["modifyText"], "updatedInstance": [1433514], "className": "UpdateTracker", "schemaClass": "UpdateTracker"}, {"dbId": 9780126, "displayName": "Update Tracker - [Reaction:1433514] Synthesis of PIP3 from PIP2 by PI3K - v64:[addLiteratureReference]", "action": ["addLiteratureReference"], "updatedInstance": [1433514], "className": "UpdateTracker", "schemaClass": "UpdateTracker"}, {"dbId": 9782565, "displayName": "Update Tracker - [Reaction:1433514] Synthesis of PIP3 from PIP2 by PI3K - v59:[add_removeLiteratureReference]", "action": ["add_removeLiteratureReference"], "updatedInstance": [1433514], "className": "UpdateTracker", "schemaClass": "UpdateTracker"}], "isChimeric": false, "category": "transition", "catalystActivity": [{"dbId": 1433507, "displayName": "1-phosphatidylinositol-3-kinase activity of PI3K:p-KIT:sSCF dimer:p-KIT,PI3K:p(Y)-GAB2:GRB2:p-SHP2:p-KIT complex [plasma membrane]", "catalyzedEvent": [1433514], "physicalEntity": {"dbId": 9031773, "displayName": "PI3K:p-KIT:sSCF dimer:p-KIT,PI3K:p(Y)-GAB2:GRB2:p-SHP2:p-KIT complex [plasma membrane]", "stId": "R-HSA-9031773", "stIdVersion": "R-HS