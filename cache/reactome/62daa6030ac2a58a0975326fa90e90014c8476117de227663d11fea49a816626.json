, "reviewed": [{"dbId": 2428957, "displayName": "Lanier, Lewis L, 2012-08-09", "dateTime": "2012-08-09 16:15:17", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 2424316, "displayName": "VAV2 and VAV3 are expressed in human NK cells and play a cen...", "text": "VAV2 and VAV3 are expressed in human NK cells and play a central role in NK cell-mediated cytotoxicity. They are required for DAP12-mediated signaling; their loss profoundly impairs DAP12-induced cytotoxicity (Billadeau et al. 2000, Cella et al. 2004). Phosphorylated SLP-76 tyrosines Y113 and Y128 provide binding sites for the SH2 domains of VAV. The binding of VAV to these phosphotyrosine residues may link SLP-76 to the Jun amino-terminal kinase (JNK) pathway and the actin cytoskeleton. Y145 has been implicated in the binding of SLP-76 to the Tec family kinase BTK (Kettner et al. 2003). BTK is required for secretion of pro-inflammatory cytokines, phosphorylation of ERK1/2 and PLCgamma and Ca2+ mobilization (Ormsby et al. 2011).", "literatureReference": [2424347, {"dbId": 2424362, "displayName": "The Rho family guanine nucleotide exchange factor Vav-2 regulates the development of cell-mediated cytotoxicity", "title": "The Rho family guanine nucleotide exchange factor Vav-2 regulates the development of cell-mediated cytotoxicity", "journal": "J. Exp. Med.", "pages": "381-92", "pubMedIdentifier": 10934226, "volume": 192, "year": 2000, "url": "http://www.ncbi.nlm.nih.gov/pubmed/10934226", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}, {"dbId": 2424401, "displayName": "Structural requirements of SLP-76 in signaling via the high-affinity immunoglobulin E receptor (Fc epsilon RI) in mast cells", "title": "Structural requirements of SLP-76 in signaling via the high-affinity immunoglobulin E receptor (Fc epsilon RI) in mast cells", "journal": "Mol. Cell. Biol.", "pages": "2395-406", "pubMedIdentifier": 12640123, "volume": 23, "year": 2003, "url": "http://www.ncbi.nlm.nih.gov/pubmed/12640123", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}], "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "updateTrackers": [{"dbId": 9788040, "displayName": "Update Tracker - [Reaction:2424481] Recruitment of VAV and BTK to p-SLP-76 - v44:[addInput, modifyText]", "action": ["addInput", "modifyText"], "updatedInstance": [2424481], "className": "UpdateTracker", "schemaClass": "UpdateTracker"}], "isChimeric": false, "category": "binding", "input": [{"dbId": 197948, "displayName": "BTK [cytosol]", "stId": "R-HSA-197948", "stIdVersion": "R-HSA-197948.1", "maxDepth": 1, "name": ["BTK", "Tyrosine-protein kinase BTK", "BTK_HUMAN"], "speciesName": "Homo sapiens", "consumedByEvent": [2424481], "species": 48887, "endCoordinate": 659, "referenceType": "ReferenceGeneProduct", "startCoordinate": 2, "className": "Protein", "inDisease": false, "schemaClass": "EntityWithAccessionedSequence"}, {"dbId": 2424458, "displayName": "VAV2,VAV3 [cytosol]", "stId": "R-HSA-2424458", "stIdVersion": "R-HSA-2424458.1", "maxDepth": 2, "name": ["VAV2,VAV3"], "speciesName": "Homo sapiens", "consumedByEvent": [2424481], "species": [48887], "className": "Set", "inDisease": false, "schemaClass": "DefinedSet"}, {"dbId": 179838, "displayName": "PI(3,4,5)P3 [plasma membrane]", "stId": "R-ALL-179838", "stIdVersion": "R-ALL-179838.4", "maxDepth": 1, "name": ["PI(3,4,5)P3", "PIP3", "1-phosphatidyl-1D-myo-inositol 3,4,5-trisphosphate", "Phosphatidylinositol-3,4,5-trisphosphate"], "crossReference": [{"dbId": 38118, "displayName": "COMPOUND:C05981", "databaseName": "COMPOUND", "identifier": "C05981", "url": "https://www.kegg.jp/entry/C05981", "className": "DatabaseIdentifier", "schemaClass": "DatabaseIdentifier"}], "positivelyRegulates": [{"db