InstanceEdit"}], "species": [48887], "summation": [{"dbId": 202256, "displayName": "Raft localized PKC theta is further phosphorylated and activ...", "text": "Raft localized PKC theta is further phosphorylated and activated by PDK1. The threonine residue (T538) in the kinase domain is the potential target of PDK1. Phosphorylation of this site is critical for the PKC theta kinase activity, and its ability to activate NF-kB pathway. PKC theta is later trans-autophopshorylated on putative phosphorylation sites (S676, S695) for the fine-tuning of its kinase activity. ", "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "category": "transition", "catalystActivity": [{"dbId": 202386, "displayName": "protein serine/threonine kinase activity of PDK1:PIP2,PIP3 [plasma membrane]", "catalyzedEvent": [202222], "physicalEntity": {"dbId": 202311, "displayName": "PDK1:PIP2,PIP3 [plasma membrane]", "stId": "R-HSA-202311", "stIdVersion": "R-HSA-202311.1", "maxDepth": 3, "name": ["PDK1:PIP2,PIP3", "PDK1 bound to either PIP3 or PI(3,4)P2"], "speciesName": "Homo sapiens", "catalystActivities": [202386], "inDisease": false, "schemaClass": "Complex", "className": "Complex"}, "className": "CatalystActivity", "schemaClass": "CatalystActivity"}], "catalystActivityReference": {"dbId": 9643435, "displayName": "protein serine/threonine kinase activity of PDK1:PIP2,PIP3 [plasma membrane] Protein kinase B kinases that mediate phosphatidylinositol 3,4,5-trisphosphate-dependent activation of protein kinase B", "literatureReference": [{"dbId": 162390, "displayName": "Protein kinase B kinases that mediate phosphatidylinositol 3,4,5-trisphosphate-dependent activation of protein kinase B", "title": "Protein kinase B kinases that mediate phosphatidylinositol 3,4,5-trisphosphate-dependent activation of protein kinas