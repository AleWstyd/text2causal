lassName": "DatabaseIdentifier", "schemaClass": "DatabaseIdentifier"}], "abbreviation": "HSA", "className": "Species", "schemaClass": "Species"}], "hasDiagram": true, "hasEHLD": false, "hasEvent": [9656207], "schemaClass": "Pathway", "className": "Pathway"}], "literatureReference": [{"dbId": 6802011, "displayName": "Exome sequencing identifies recurrent mutations in NF1 and RASopathy genes in sun-exposed melanomas", "title": "Exome sequencing identifies recurrent mutations in NF1 and RASopathy genes in sun-exposed melanomas", "journal": "Nat. Genet.", "pages": "996-1002", "pubMedIdentifier": 26214590, "volume": 47, "year": 2015, "url": "http://www.ncbi.nlm.nih.gov/pubmed/26214590", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}, {"dbId": 9655515, "displayName": "Molecular and clinical analysis of RAF1 in Noonan syndrome and related disorders: dephosphorylation of serine 259 as the essential mechanism for mutant activation", "title": "Molecular and clinical analysis of RAF1 in Noonan syndrome and related disorders: dephosphorylation of serine 259 as the essential mechanism for mutant activation", "journal": "Hum. Mutat.", "pages": "284-94", "pubMedIdentifier": 20052757, "volume": 31, "year": 2010, "url": "http://www.ncbi.nlm.nih.gov/pubmed/20052757", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}, {"dbId": 9655488, "displayName": "Germline gain-of-function mutations in RAF1 cause Noonan syndrome", "title": "Germline gain-of-function mutations in RAF1 cause Noonan syndrome", "journal": "Nat. Genet.", "pages": "1013-7", "pubMedIdentifier": 17603482, "volume": 39, "year": 2007, "url": "http://www.ncbi.nlm.nih.gov/pubmed/17603482", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}, {"dbId": 444324, "displayName": "Gain-of-function RAF1 mutations cause Noonan and LEOPARD syndromes with hypertrophic cardiomyopathy", "title": "Gain-of-function RAF1 mutations cause Noonan and LEOPARD syndromes with hypertrophic cardiomyopathy", "journal": "Nat Genet", "pages": "1007-12", "pubMedIdentifier": 17603483, "volume": 39, "year": 2007, "url": "http://www.ncbi.nlm.nih.gov/pubmed/17603483", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}, {"dbId": 9655523, "displayName": "Spectrum of mutations in Noonan syndrome and their correlation with phenotypes", "title": "Spectrum of mutations in Noonan syndrome and their correlation with phenotypes", "journal": "J. Pediatr.", "pages": "1029-35", "pubMedIdentifier": 21784453, "volume": 159, "year": 2011, "url": "http://www.ncbi.nlm.nih.gov/pubmed/21784453", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}], "reviewed": [{"dbId": 9686656, "displayName": "Gavathiotis, Evripidis, 2020-05-04", "dateTime": "2020-05-04 18:19:23", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 9655953, "displayName": "RAF1 mutants have been identified in both RASopathies and va...", "text": "RAF1 mutants have been identified in both RASopathies and various cancers that show elevated levels of signaling through MAP2K and MAPK (Kobayashi et al, 2010; Razzaque et al, 2007; Krauthammer et al, 2015; Pandit et al, 2007; Lee et al, 2011). RAF1 proteins with mutations that cluster in the conserved region 2 (CR2) domain of RAF1 show decreased levels of phosphorylation on S259, which is required for the interaction of RAF1 with the YWHAB 14-3-3 proteins (Kobayashi et al, 2010). Consistent with this CR2 RAF1 mutants show decreased interaction with YWHAB and increased downstream signaling (Kobayashi et al, 2010; Pandit et al, 2007; Lee et al, 2011).", "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "isChimeric": false, "category": "transition", "entityFunctionalStatus"