0", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "category": "transition", "regulatedBy": [{"dbId": 10055925, "displayName": "Positive regulation by 'ATP2B4:NOS1 [plasma membrane]'", "regulatedEntity": [10055924], "schemaClass": "PositiveRegulation", "className": "PositiveRegulation"}], "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 6809173, "displayName": "Colotti, Gianni, 2015-11-09", "dateTime": "2015-11-09 18:48:09", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 5617210, "displayName": "Human cardiac troponin I (TNNI3) is known to be phosphorylat...", "text": "Human cardiac troponin I (TNNI3) is known to be phosphorylated at multiple amino acid residue sites by several kinases. Protein kinase A (PRKACA) can phosphorylate serine 23 and 24 sites on TNNI3. Phosphorylation of TNNI3 reduces myofilament calcium sensitivity (Mittmann et al. 1990, Keane et al. 1997, Zhang et al. 2012). Defects in TNNI3 can cause a range of cardiomyopathies (Lu et al. 2013). The ATP2B4:NOS1 complex, via cAMP, increases PRKACA activity, thereby regulating the response of the heart to beta-adrenergic agonists.", "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "isChimeric": false, "category": "transition", "catalystActivity": [{"dbId": 914181, "displayName": "cAMP-dependent protein kinase activity of PRKACA [cytosol]", "catalyzedEvent": [5617179], "physicalEntity": {"dbId": 57844, "displayName": "PRKACA [cytosol]", "stId": "R-HSA-57844", "stIdVersion": "R-HSA-57844.1", "maxDepth": 1, "name": ["PRKACA", "PKA C-alpha", "cAMP-dependent protein kinase, alpha-catalytic subunit "], "speciesName": "Homo sapiens", "catalystActivities": [914181], "endCoordinate": 351, "referenceType": "Referenc