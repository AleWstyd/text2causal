egicus", "inferredFrom": [2424480], "species": [{"dbId": 48895, "displayName": "Rattus norvegicus", "name": ["Rattus norvegicus", "R. norvegicus", "Rn", "brown rat", "Norway rat"], "taxId": "10116", "abbreviation": "RNO", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 2428957, "displayName": "Lanier, Lewis L, 2012-08-09", "dateTime": "2012-08-09 16:15:17", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 2424321, "displayName": "Activated PI3K phosphorylates phosphatidylinositol (PI) 4-ph...", "text": "Activated PI3K phosphorylates phosphatidylinositol (PI) 4-phosphate and PI 4,5-bisphosphate (PIP2) to generate PI 3,4-bisphosphate and PI 3,4,5-triphosphate (PIP3) and these second messengers recruit other signaling proteins containing plecstrin homology (PH) domain. Products of PI3K are involved in the regulation of PLC-gamma 1 and VAV activation. The PH domain of PLC-gamma 1 binds to PIP3 and is targeted to the membrane. PIP3 binds to the PH domain of VAV2/VAV3 and increases it activity and PI3K may also strongly stimulate VAV activity by converting an inhibitory regulator VAV to an activator (Toker & Cantley 1997, Fischer et al. 1998, Falasca et al. 1998).", "literatureReference": [{"dbId": 437166, "displayName": "Signalling through the lipid products of phosphoinositide-3-OH kinase", "title": "Signalling through the lipid products of phosphoinositide-3-OH kinase", "journal": "Nature", "pages": "673-6", "pubMedIdentifier": 9192891, "volume": 387, "year": 1997, "url": "http://www.ncbi.nlm.nih.gov/pubmed/9192891", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}, {"dbId": 191524, "displayName": "Activation of phospholipase C gamma by PI 3-kinase-induced PH domain-mediated membrane targeting", "title": "Activation of phospholipase C gamma by PI 3-kinase-induced PH domain-mediated membrane targeting", "journal": "EMBO J", "pages": "414-22", "pubMedIdentifier": 9430633, "volume": 17, "year": 1998, "url": "http://www.ncbi.nlm.nih.gov/pubmed/9430633", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}, {"dbId": 2424358, "displayName": "Vav links antigen-receptor signaling to the actin cytoskeleton", "title": "Vav links antigen-receptor signaling to the actin cytoskeleton", "journal": "Semin. Immunol.", "pages": "317-27", "pubMedIdentifier": 9695188, "volume": 10, "year": 1998, "url": "http://www.ncbi.nlm.nih.gov/pubmed/9695188", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}], "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "category": "transition", "catalystActivity": [{"dbId": 2424483, "displayName": "1-phosphatidylinositol-4,5-bisphosphate 3-kinase activity of DAP12 Receptors:p-DAP12:p-6Y-SYK:PI3K [plasma membrane]", "catalyzedEvent": [2424480], "physicalEntity": {"dbId": 2424456, "displayName": "DAP12 Receptors:p-DAP12:p-6Y-SYK:PI3K [plasma membrane]", "stId": "R-HSA-2424456", "stIdVersion": "R-HSA-2424456.1", "maxDepth": 6, "name": ["DAP12 Receptors:p-DAP12:p-6Y-SYK:PI3K"], "speciesName": "Homo sapiens", "catalystActivities": [2424483], "inDisease": false, "schemaClass": "Complex", "className": "Complex"}, "className": "CatalystActivity", "schemaClass": "CatalystActivity"}], "input": [{"dbId": 113592, "displayName": "ATP [cytosol]", "stId": "R-ALL-113592", "stIdVersion": "R-ALL-113592.5", "maxDepth": 1, "name": ["ATP", "Adenosine 5'-triphosphate", "ATP(4-)"], "crossReference": [{"dbId": 29359, "displayName": "COMPOUND:C00002", "databaseName": "COMPOUND", "identifier": "C00002", "url": "https://www.kegg.jp/entry/C00002", "className": "DatabaseIdentifier", "schemaClass": "DatabaseIdentifier"}], "isRequired"