ease": false, "isInferred": true, "maxDepth": 1, "name": ["PKA phosphorylates RET:GDNF:GFRA dimer"], "releaseDate": "2026-03-25", "speciesName": "Rattus norvegicus", "inferredFrom": [8854908], "species": [{"dbId": 48895, "displayName": "Rattus norvegicus", "name": ["Rattus norvegicus", "R. norvegicus", "Rn", "brown rat", "Norway rat"], "taxId": "10116", "abbreviation": "RNO", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10076682, "displayName": "PKA phosphorylates RET:GDNF:GFRA dimer", "stId": "R-MMU-8854908", "stIdVersion": "R-MMU-8854908.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["PKA phosphorylates RET:GDNF:GFRA dimer"], "releaseDate": "2026-03-25", "speciesName": "Mus musculus", "inferredFrom": [8854908], "species": [{"dbId": 48892, "displayName": "Mus musculus", "name": ["Mus musculus", "M. musculus", "Mm", "house mouse"], "taxId": "10090", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 8871576, "displayName": "Luo, Wenqin, 2016-05-17", "dateTime": "2016-05-17 16:01:39", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}, {"dbId": 8869653, "displayName": "Morales, Daniel, 2016-05-06", "dateTime": "2016-05-06 15:36:41", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 8854893, "displayName": "Serine (S) 696 in RET is phosphorylated by protein kinase A....", "text": "Serine (S) 696 in RET is phosphorylated by protein kinase A. Mutation of this serine almost completely inhibits the ability of RET to activate the small GTPase Rac1 and stimulate formation of cell lamellipodia (Fukuda et al. 2002). Homozygous knock-in mice carrying this mutation lacked enteric neurons in the distal colon, resulting from a migration defect of enteric neural crest cells (Asai et al. 2006). The effects of the S696 RET mutant could be alleviated by simultaneous mutation of Tyrosine-687 (Fukuda et al. 2002). Activation of PKA by forskolin was found to impair the recruitment of SHP2 to RET and negatively affect ligand-mediated neurite outgrowth (Perrinjaquet et al. 2010). Mutation of S696 enhanced SHP2 binding and eliminated the effect of forskolin on ligand-induced neurite outgrowth.", "literatureReference": [8854898, {"dbId": 8855758, "displayName": "Targeted mutation of serine 697 in the Ret tyrosine kinase causes migration defect of enteric neural crest cells", "title": "Targeted mutation of serine 697 in the Ret tyrosine kinase causes migration defect of enteric neural crest cells", "journal": "Development", "pages": "4507-16", "pubMedIdentifier": 17050626, "volume": 133, "year": 2006, "url": "http://www.ncbi.nlm.nih.gov/pubmed/17050626", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}, {"dbId": 8854869, "displayName": "Protein-tyrosine phosphatase SHP2 contributes to GDNF neurotrophic activity through direct binding to phospho-Tyr687 in the RET receptor tyrosine kinase", "title": "Protein-tyrosine phosphatase SHP2 contributes to GDNF neurotrophic activity through direct binding to phospho-Tyr687 in the RET receptor tyrosine kinase", "journal": "J. Biol. Chem.", "pages": "31867-75", "pubMedIdentifier": 20682772, "volume": 285, "year": 2010, "url": "http://www.ncbi.nlm.nih.gov/pubmed/20682772", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}], "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "isChimeric": false, "category": "transition", "catalystActivity": [{"dbId": 426259, "displayName": "protein serine/threonine kinase activity of Protein kinase A catalytic subunit [cytosol]", "catalyzedEvent"