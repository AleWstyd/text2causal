onventional Protein Kinase C (cPKC) isoforms have two membrane-targetting domains, a C1 domain which binds to the membrane lipid diacylglycerol (DAG) and a C2 domain which binds membrane phospholipids such as phosphatidylserine, in a calcium-dependent manner. Association of both domains with the plasma membrane produces a conformational change that releases an autoinhibitory pseudosubstrate segment from the substrate-binding cavity, allowing substrate binding and downstream signaling.", "literatureReference": [425852, {"dbId": 434875, "displayName": "9780306478635  Protein Kinase C 2nd ed Dekker, L", "title": "Protein Kinase C 2nd ed", "year": 2004, "isbn": "9780306478635", "className": "Book", "schemaClass": "Book"}, {"dbId": 425857, "displayName": "The extended protein kinase C superfamily", "title": "The extended protein kinase C superfamily", "journal": "Biochem J", "pages": "281-92", "pubMedIdentifier": 9601053, "volume": 332, "year": 1998, "url": "http://www.ncbi.nlm.nih.gov/pubmed/9601053", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}], "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "updateTrackers": [{"dbId": 9791518, "displayName": "Update Tracker - [Reaction:114553] Activation of conventional Protein Kinase C - v29:[addRegulator]", "action": ["addRegulator"], "updatedInstance": [114553], "className": "UpdateTracker", "schemaClass": "UpdateTracker"}, {"dbId": 9775595, "displayName": "Update Tracker - [Reaction:114553] Activation of conventional Protein Kinase C - v78:[addSummation]", "action": ["addSummation"], "updatedInstance": [114553], "className": "UpdateTracker", "schemaClass": "UpdateTracker"}, {"dbId": 9791460, "displayName": "Update Tracker - [Reaction:114553] Activation of conventional Protein Kinase C - v30:[addInput, add_remov