 [{"dbId": 9037710, "displayName": "Castr\u00e9n, Eero, 2018-02-13", "dateTime": "2018-02-13 05:00:00", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}, {"dbId": 9037707, "displayName": "Antila, Hanna, 2018-02-13", "dateTime": "2018-02-13 05:00:00", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 9026578, "displayName": "Ligand-activated NTRK2 (TRKB) phosphorylates PLCG1 (PLCgamma...", "text": "Ligand-activated NTRK2 (TRKB) phosphorylates PLCG1 (PLCgamma1). Direct phosphorylation of PLCG1 by NTF3-stimulated NTRK2 on PLCG1 tyrosine residues Y783 and Y1253 was demonstrated using rat Ntrk2 and Plcg1. Phosphorylation of Y771 of PLCG1 was indirectly inferred (Middlemas et al. 1994). While phosphorylation of tyrosine residue Y472 of PLCG1 by NTRK2 has not been examined, it is assumed based on similarity with other receptor tyrosine kinases and requirements for the catalytic activity of PLCG1.<p>PLCG1 signaling is activated in response to BDNF-mediated activation of the NTRK2 receptor (Eide et al. 1996, Yamada et al. 2002) and involves NTRK2-mediated phosphorylation of PLCG1 (McCarthy and Feinstein 1999, Yuen and Mobley 1999).<p>Activation of NTRK2 signaling by NTF4 (NT-4) also results in tyrosine phosphorylation of PLCG1 (Yuen and Mobley 1999).", "literatureReference": [9026468, 9026801, 9032396, 9026808, {"dbId": 9026574, "displayName": "Identification of TrkB autophosphorylation sites and evidence that phospholipase C-gamma 1 is a substrate of the TrkB receptor", "title": "Identification of TrkB autophosphorylation sites and evidence that phospholipase C-gamma 1 is a substrate of the TrkB receptor", "journal": "J. Biol. Chem.", "pages": "5458-66", "pubMedIdentifier": 8106527, "volume": 269, "year": 1994, "url": "http://www.ncbi.nlm.nih.gov/pubmed/8106527", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}], "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": 