maxDepth": 1, "name": ["AKT phosphorylates AKT1S1 (PRAS40)"], "releaseDate": "2026-03-25", "speciesName": "Mus musculus", "inferredFrom": [200143], "species": [{"dbId": 48892, "displayName": "Mus musculus", "name": ["Mus musculus", "M. musculus", "Mm", "house mouse"], "taxId": "10090", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 202668, "displayName": "Greene, LA, 2007-11-08 15:39:37", "dateTime": "2007-11-08 20:39:37", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 200160, "displayName": "PRAS40 (proline-rich Akt/PKB substrate 40 kDa) is a substrat...", "text": "PRAS40 (proline-rich Akt/PKB substrate 40 kDa) is a substrate of AKT, the phosphorylation of which leads to the binding of this protein to 14-3-3. PRAS40 binds to mTOR complexes, mediating AKT signals to mTOR. Interaction of PRAS40 with the mTOR kinase domain is induced under conditions that inhibit mTOR signalling, such as growth factor deprivation. Binding of PRAS40 inhibits mTOR. PRAS40 phosphorylation by AKT and association with the cytosolic anchor protein 14-3-3, lead to mTOR stimulation (Vander Haar E, et al, 2007). Although it was originally identified in the context of insulin signalling, it was later shown that PRAS40 may also play a role in nerve growth factor-mediated neuroprotection (Saito A, et al, 2004).", "literatureReference": [{"dbId": 200166, "displayName": "Insulin signalling to mTOR mediated by the Akt/PKB substrate PRAS40", "title": "Insulin signalling to mTOR mediated by the Akt/PKB substrate PRAS40", "journal": "Nat Cell Biol", "pages": "316-23", "pubMedIdentifier": 17277771, "volume": 9, "year": 2007, "url": "http://www.ncbi.nlm.nih.gov/pubmed/17277771", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}, {"dbId": 200161, "displayName": "Neuroprotective role of a proline-rich Akt substrate in apoptotic neuronal cell death after stroke: relationships with nerve growth factor", "title": "Neuroprotective role of a proline-rich Akt substrate in apoptotic neuronal cell death after stroke: relationships with nerve growth factor", "journal": "J Neurosci", "pages": "1584-93", "pubMedIdentifier": 14973226, "volume": 24, "year": 2004, "url": "http://www.ncbi.nlm.nih.gov/pubmed/14973226", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}], "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "category": "transition", "catalystActivity": [{"dbId": 198368, "displayName": "protein serine/threonine kinase activity of p-T,p-S-AKT [cytosol]", "catalyzedEvent": [200143], "physicalEntity": {"dbId": 202074, "displayName": "p-T,p-S-AKT [cytosol]", "stId": "R-HSA-202074", "stIdVersion": "R-HSA-202074.2", "maxDepth": 2, "name": ["p-T,p-S-AKT", "Active AKT"], "speciesName": "Homo sapiens", "catalystActivities": [198368], "className": "Set", "inDisease": false, "schemaClass": "CandidateSet"}, "className": "CatalystActivity", "schemaClass": "CatalystActivity"}], "input": [{"dbId": 113592, "displayName": "ATP [cytosol]", "stId": "R-ALL-113592", "stIdVersion": "R-ALL-113592.5", "maxDepth": 1, "name": ["ATP", "Adenosine 5'-triphosphate", "ATP(4-)"], "crossReference": [{"dbId": 29359, "displayName": "COMPOUND:C00002", "databaseName": "COMPOUND", "identifier": "C00002", "url": "https://www.kegg.jp/entry/C00002", "className": "DatabaseIdentifier", "schemaClass": "DatabaseIdentifier"}], "isRequired": [{"dbId": 72781, "displayName": "Requirement by 'ATP [cytosol]'", "stId": "R-HSA-72781", "stIdVersion": "R-HSA-72781.1", "regulator": 113592, "schemaClass": "Requirement", "className": "Requirement"}], "negativelyRegulates": [{"dbId": 453366, "displayName": "Neg