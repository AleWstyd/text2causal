: false, "isInferred": true, "maxDepth": 1, "name": ["Active IKK Complex phosphorylates NF-kappa-B inhibitor "], "releaseDate": "2026-03-25", "speciesName": "Mus musculus", "inferredFrom": [168140], "species": [{"dbId": 48892, "displayName": "Mus musculus", "name": ["Mus musculus", "M. musculus", "Mm", "house mouse"], "taxId": "10090", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "category": "transition", "regulatedBy": [{"dbId": 9996868, "displayName": "Negative regulation by 'NKIRAS [cytosol]'", "regulatedEntity": [9996867], "schemaClass": "NegativeRegulation", "className": "NegativeRegulation"}], "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 2129340, "displayName": "Upton, JW, Mocarski, ES, 2012-02-19", "dateTime": "2012-02-19 23:34:36", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}, {"dbId": 2582977, "displayName": "Fitzgerald, Katherine A, 2012-11-13", "dateTime": "2012-11-13 23:46:08", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}, {"dbId": 2023355, "displayName": "D'Eustachio, P, 2011-12-07", "dateTime": "2011-12-08 02:10:50", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}, {"dbId": 2603254, "displayName": "Napetschnig, Johanna, 2012-11-16", "dateTime": "2012-11-16 19:43:52", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "revised": [{"dbId": 442879, "displayName": "Shamovsky, V, 2009-09-29", "dateTime": "2009-09-29 20:39:25", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 450273, "displayName": "In human, IkBs (NFKBIA, NFKBIB or NFKBIE) are inhibitory pro...", "text": "In human, IkBs (NFKBIA, NFKBIB or NFKBIE) are inhibitory proteins that sequesters NF-kappa-B in the cytoplasm, by masking a nuclear localization signal, located just at the C-terminal end of the RelA (p65) subunit of the RelA:NFKB1 heterodimer. <p>A key event in NF-kappa-B activation involves phosphorylation of IkB by an IkB kinase (IKK). The phosphorylation and ubiquitination of IkB kinase complex is mediated by two distinct pathways, either the classical or alternative pathway. In the classical NF-kappa-B signaling pathway, the activated IKK (IkB kinase) complex, predominantly acting through IKK beta (IKKb, IKBKB) in an IKK gamma (IKBKG, NEMO)-dependent manner, catalyzes the phosphorylation of IkBs (at sites equivalent to Ser32 and Ser36 of human NFKBIA (IkB-alpha) or Ser19 and Ser22 of NFKBIB (IkB-beta)). Once phosphorylated, IkB undergoes ubiquitin-mediated degradation, releasing NF-kappa-B.<br>", "literatureReference": [434140, 434149], "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "updateTrackers": [{"dbId": 9781856, "displayName": "Update Tracker - [Reaction:168140] Active IKK Complex phosphorylates NF-kappa-B inhibitor  - v60:[addRegulator]", "action": ["addRegulator"], "updatedInstance": [168140], "className": "UpdateTracker", "schemaClass": "UpdateTracker"}, {"dbId": 9777883, "displayName": "Update Tracker - [Reaction:168140] Active IKK Complex phosphorylates NF-kappa-B inhibitor  - v68:[addLiteratureReference]", "action": ["addLiteratureReference"], "updatedInstance": [168140], "className": "UpdateTracker", "schemaClass": "UpdateTracker"}, {"dbId": 9788855, "displayName": "Update Tracker - [Reaction:168140] Active IKK Complex phosphorylates NF-kappa-B inhibitor  - v40:[modifyText]", "action": ["modifyText"], "updatedInstance": [168140], "className": "UpdateTracker", "schemaClass": "UpdateTracker"}, {"dbId": 9775251, "displayName": "Update Tracker - [Reaction:168140] Active IKK Complex phosphorylates NF-kappa-B inhibitor  - v80:[modifyText]", "action": ["modifyText"], "updatedInstance": [168140], "className": "UpdateTracker", "schemaClass": "UpdateTracker"}, {"dbId": 9791005, "displ