species": [{"dbId": 48895, "displayName": "Rattus norvegicus", "name": ["Rattus norvegicus", "R. norvegicus", "Rn", "brown rat", "Norway rat"], "taxId": "10116", "abbreviation": "RNO", "className": "Species", "schemaClass": "Species"}], "category": "binding", "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10055489, "displayName": "PKC-delta translocates to plasma membrane", "stId": "R-MMU-5607734", "stIdVersion": "R-MMU-5607734.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["PKC-delta translocates to plasma membrane"], "releaseDate": "2026-03-25", "speciesName": "Mus musculus", "inferredFrom": [5607734], "species": [{"dbId": 48892, "displayName": "Mus musculus", "name": ["Mus musculus", "M. musculus", "Mm", "house mouse"], "taxId": "10090", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "category": "binding", "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 5621625, "displayName": "Geijtenbeek, Teunis B H, 2014-09-02", "dateTime": "2014-09-02 13:22:43", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 5607611, "displayName": "Protein kinase C-delta (PRKCD), activated upon CLEC7A (Decti...", "text": "Protein kinase C-delta (PRKCD), activated upon CLEC7A (Dectin-1)-SYK signaling,  phosphorylates CARD9 leading to NF-kB activation (Strasser et al. 2012) and complex formation between CARD9 and BCL10. CLEC6A (Dectin-2) and CLEC4E (Mincle) also induces intracellular signaling through PRKCD and CARD9-BCL10-MALT1 pathway. Similar to the CLEC7A responses, both CLEC6A and CLEC4E-induced interleukin 10 (IL10) and tumour necrotic factor (TNF) production were severely impaired in the absence of PRKCD (Strasser et al. 2012). PRKCD is a member of the Ca2+ independent and diacylglycerol (DAG) dependent novel PKC subfamily. PKC family members exist in an immature inactive conformation that requires post-translational modifications to achieve catalytic maturity. The catalytic maturation of PRKCD involves the auto-phosphorylation of Ser645 and the phosphorylation of Thr507 and Ser664 (Li et al. 1997, Keranen et al. 1995). These phosphorylations of activation loop residues act as a priming step that allows the catalytic maturation of PRKCD (Dutil et al. 1998). Fully phosphorylated and primed PRKCD localises to the cytosol with its pseudosubstrate occupying the substrate-binding cavity. Signals that cause the lipid hydrolysis recruit PKC to membranes. The C1 domain in PRKCD is a cysteine-rich compact structure, identified as the interaction site for DAG and phorbol ester. PRKCD preferentially translocates to the plasma membrane (Stahelin et al. 2004, Newton 2010).", "literatureReference": [5607454, 5607226, {"dbId": 4332313, "displayName": "Protein kinase C is regulated in vivo by three functionally distinct phosphorylations", "title": "Protein kinase C is regulated in vivo by three functionally distinct phosphorylations", "journal": "Curr. Biol.", "pages": "1394-1403", "pubMedIdentifier": 8749392, "volume": 5, "year": 1995, "url": "http://www.ncbi.nlm.nih.gov/pubmed/8749392", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}, {"dbId": 4332315, "displayName": "Regulation of conventional protein kinase C isozymes by phosphoinositide-dependent kinase 1 (PDK-1)", "title": "Regulation of conventional protein kinase C isozymes by phosphoinositide-dependent kinase 1 (PDK-1)", "journal": "Curr. Biol.", "pages": "1366-75", "pubMedIdentifier": 9889098, "volume": 8, "year": 1998, "url": "http://www.ncbi.nlm.nih.gov/pubmed/9889098", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}, {"dbId": 5607202, "displayName": "Syk kinase-coupled C-type lectin receptors engage protein kinase C-? to elicit Card9 adaptor-mediated innate immunity", "title": "Syk kinase-coupled C-type lectin receptors engage protein kinase C-? to elicit Card9 adaptor-mediated innate immunity", "journal": "Immunity", "pages": "32-42", "pubMedIdentifier": 22265677, "volume": 36, "year": 2012, "url": "http://www.ncbi.nlm.nih.gov/pubmed/22265677", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}, {"dbId": 5607233, "displayName": "Identification of serine 643 of protein kinase C-delta as an important autophosphorylation site for its enzymatic activity", "title": "Identification of serine 643 of protein kinase C-delta as an important autophosphorylation site for its enzymatic activity", "journal": "J. Biol. Chem.", "pages": "24550-5", "pubMedIdentifier": 9305920, "volume": 272, "year": 1997, "url": "http://www.ncbi.nlm.nih.gov/pubmed/9305920", "className": "LiteratureReference", "schemaClass": "LiteratureReference"}], "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "isChimeric": false, "category": "binding", "input": [{"dbId": 112275, "displayName": "DAGs [plasma membrane]", "stId": "R-ALL-112275", "stIdVersion": "R-ALL-112275.3", "maxDepth": 1, "name": ["DAGs", "diacylglycerols", "diglyceride", "DAG"], "crossReference": [{"dbId": 29669, "displayName": "COMPOUND:C00165", "databaseName": "COMPOUND", "identifier": "C00165", "url": "https://www.kegg.jp/entry/C00165", "className": "DatabaseIdentifier", "schemaClass": "DatabaseIdentifier"}], "positivelyRegulates": [{"dbId": 8855329, "displayName": "Positive regulation by 'DAGs [plasma membrane]'", "stId": "R-XLA-8855329", "stIdVersion": "R-XLA-8855329.1", "regulator": 112275, "schemaClass": "PositiveRegulation", "className": "PositiveRegulation"}, {"dbId": 8855331, "displayName": "Positive regulation by 'DAGs [plasma membrane]'", "stId": "R-HSA-8855331", "stIdVersion": "R-HSA-8855331.1", "regulator": 112275, "schemaClass": "PositiveRegulation", "className": "PositiveRegulation"}], "consumedByEvent": [56077