ame": "Species", "schemaClass": "Species"}], "category": "binding", "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10125650, "displayName": "Translocation of PKC theta to plasma membrane", "stId": "R-RNO-202328", "stIdVersion": "R-RNO-202328.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["Translocation of PKC theta to plasma membrane"], "releaseDate": "2026-03-25", "speciesName": "Rattus norvegicus", "inferredFrom": [202328], "species": [{"dbId": 48895, "displayName": "Rattus norvegicus", "name": ["Rattus norvegicus", "R. norvegicus", "Rn", "brown rat", "Norway rat"], "taxId": "10116", "abbreviation": "RNO", "className": "Species", "schemaClass": "Species"}], "category": "binding", "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10004450, "displayName": "Translocation of PKC theta to plasma membrane", "stId": "R-MMU-202328", "stIdVersion": "R-MMU-202328.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["Translocation of PKC theta to plasma membrane"], "releaseDate": "2026-03-25", "speciesName": "Mus musculus", "inferredFrom": [202328], "species": [{"dbId": 48892, "displayName": "Mus musculus", "name": ["Mus musculus", "M. musculus", "Mm", "house mouse"], "taxId": "10090", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "category": "binding", "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 214481, "displayName": "Trowsdale, J, 2008-02-26 12:02:59", "dateTime": "2008-02-26 17:02:59", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 202380, "displayName": "DAG along with intracellular calcium signals cooperatively t...", "text": "DAG along with intracellular calcium signals cooperatively to activate PKCs, which then trigger other pathways such as the NF-kB pathway, ultimately leading to mast cell (MC) degranulation and cytokine production (Wu 2011). PKC theta is a member of the Ca++ independent and DAG dependent, novel PKC subfamily expressed mainly in T cells. It contains, N-term C2 like domain, a pseudosubstrate (PS), DAG binding (C1) domain and a C-term kinase domain. The PS sequence resembles an ideal substrate with the exception that it contains an alanine residue instead of a substrate serine residue, is bound to the kinase  domain in the resting state. As a result, PKC theta is maintained in a closed inactive state, which is inaccessible to cellular substrates.<br>MCs express several Protein kinase C (PKC) isozymes and these kinases are involved in both the activation and termination of the degranulation process. PKC-delta is a negative regulator of FCERI mediated mast cell degranulation, whereas PKC-theta facilitates in degranulation (Leitges et al. 2002, Liu et al. 2001). In response to FCERI activation PKC-theta translocates to membrane by binding to DAG with its C1 domain. PKC-theta exists in two conformations closed/inactive and open/active state. In resting state, PKC-theta is autoinhibited where the pseudosubstrate sequence in the N-terminal regulatory region of PKC-theta forms intramolecular interaction with the substrate-binding region in the catalytic domain. This prevents the catalytic domain gaining access to substrates. The allosteric change of PKC-theta from closed to open state involves two important mechanisms: DAG binding to the C1 domains and autophosphorylation of T538 on the activation loop. Interaction with DAG induces conformational change resulting in the exposure of the activation loop of PKC-theta (Wang et al. 2012, Melowic et al. 2007).", "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "deleted": [{"dbId": 8875149, "displayName": "Deletion of instance: 2730875", "curatorComment": "This duplicate event is replaced with event 202328", "replacementInstances": [202328], "deletedInstanceDbId": [2730875], "className": "Deleted", "schemaClass": "Deleted"}], "updateTrackers": [{"dbId": 9783128, "displayName": "Update Tracker - [Reaction:202328] Translocation of PKC theta to plasma membrane - v57:[addLiteratureReference, modifyText]", "action": ["addLiteratureReference", "modifyText"], "updatedInstance": [202328], "className": "UpdateTracker", "schemaClass": "UpdateTracker"}], "category": "binding", "input": [{"dbId": 202185, "displayName": "PRKQC closed conformation [cytosol]", "stId": "R-HSA-202185", "stIdVersion": "R-HSA-202185.1", "maxDepth": 1, "name": ["PRKQC closed conformation", "PKC-theta (closed)"], "speciesName": "Homo sapiens", "consumedByEvent": [202328], "species": 48887, "endCoordinate": 706, "referenceType": "ReferenceGeneProduct", "startCoordinate": 1, "className": "Protein", "inDisease": false, "schemaClass": "EntityWithAccessionedSequence"}, {"dbId": 112275, "displayName": "DAGs [plasma membrane]", "stId": "R-ALL-112275", "stIdVersion": "R-ALL-112275.3", "maxDepth": 1, "name": ["DAGs", "diacylglycerols", "diglyceride", "DAG"], "crossReference": [{"dbId": 29669, "displayName": "COMPOUND:C00165", "databaseName": "COMPOUND", "identifier": "C00165", "url": "https://www.kegg.jp/entry/C00165", "className": "DatabaseIdentifier", "schemaClass": "DatabaseIdentifier"}], "positivelyRegulates": [{"dbId": 8855329, "displayName": "Positive regulation by 'DAGs [plasma membrane]'", "stId": "R-XLA-8855329", "stIdVersion": "R-XLA-8855329.1", "regulator": 112275, "schemaClass": "PositiveRegulation", "className": "PositiveRegulation"}, {"dbId": 8855331, "displayName": "Positive regulation by 'DAGs [plasma membrane]'", "stId": "R-HSA-8855331", "stIdVersion": "R-HSA-8855331.1", "regulator": 112275, "schemaClass": "PositiveRegulation", "className": "PositiveRegulation"}], "consumedByEvent": [202328], "referenceType": "ReferenceMolecule", "className": "Chemical Compound", "inDisease": false, "schemaClas