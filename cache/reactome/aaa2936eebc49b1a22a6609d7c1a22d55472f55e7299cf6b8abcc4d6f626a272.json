ame": "LiteratureReference", "schemaClass": "LiteratureReference"}, 9667872], "reviewed": [{"dbId": 9729891, "displayName": "Inghirami, Giorgio, 2021-05-04", "dateTime": "2021-05-04 17:20:27", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 9725321, "displayName": "CEBPB is a transcription factor with roles in immune and inf...", "text": "CEBPB is a transcription factor with roles in immune and inflammatory reponses that was identified as a target of NPM-ALK signaling downstream of STAT3 and MAPK1/3 (Piva et al, 2006; Quintanilla-Martinez et al, 2006; Anastasov et al, 2010). CEBPB expression is downregulated after treatment of cells with anti-NPM-ALK RNAi or shRNA. CEBPB expression downstream of NPM-ALK signaling promotes cellular survival, as its knockdown increases the proportion of cells undergoing apoptosis. In mouse models of NPM-ALK, CEBPB is required for entry into S phase and contributes to the transforming properties of the fusion protein. (Piva et al, 2006; Quintanilla-Martinez et al, 2006; Anastasov et al, 2010; reviewed in Hallberg and Palmer, 2013).", "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "updateTrackers": [{"dbId": 9853232, "displayName": "Update Tracker - [BlackBoxEvent:9725357] NPM1-ALK-dependent CEBPB gene expression - v87:[addLiteratureReference, modifyText]", "action": ["addLiteratureReference", "modifyText"], "updatedInstance": [9725357], "className": "UpdateTracker", "schemaClass": "UpdateTracker"}], "isChimeric": false, "category": "omitted", "input": [{"dbId": 3858376, "displayName": "CEBPB gene [nucleoplasm]", "stId": "R-HSA-3858376", "stIdVersion": "R-HSA-3858376.2", "maxDepth": 1, "name": ["CEBPB gene"], "speciesName": "Homo sapiens", "consumedByEvent": [9725357], "species": 48887, "en