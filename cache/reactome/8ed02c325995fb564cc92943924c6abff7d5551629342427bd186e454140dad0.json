Id": 48898, "displayName": "Bos taurus", "name": ["Bos taurus", "B. taurus", "Bt", "bovine", "cattle", "cow", "domestic cattle", "domestic cow"], "taxId": "9913", "abbreviation": "BTA", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10319678, "displayName": "KRAS4B is phosphorylated on serine 181", "stId": "R-CFA-9653503", "stIdVersion": "R-CFA-9653503.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["KRAS4B is phosphorylated on serine 181"], "releaseDate": "2026-03-25", "speciesName": "Canis familiaris", "inferredFrom": [9653503], "species": [{"dbId": 49646, "displayName": "Canis familiaris", "name": ["Canis familiaris", "Canis lupus familiaris"], "taxId": "9615", "abbreviation": "CFA", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}, {"dbId": 10089224, "displayName": "KRAS4B is phosphorylated on serine 181", "stId": "R-MMU-9653503", "stIdVersion": "R-MMU-9653503.1", "isInDisease": false, "isInferred": true, "maxDepth": 1, "name": ["KRAS4B is phosphorylated on serine 181"], "releaseDate": "2026-03-25", "speciesName": "Mus musculus", "inferredFrom": [9653503], "species": [{"dbId": 48892, "displayName": "Mus musculus", "name": ["Mus musculus", "M. musculus", "Mm", "house mouse"], "taxId": "10090", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "category": "transition", "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 9686656, "displayName": "Gavathiotis, Evripidis, 2020-05-04", "dateTime": "2020-05-04 18:19:23", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 9653501, "displayName": "KRAS4B is phosphorylated on serine 181 by PKC theta or cGMP ...", "text": "KRAS4B is phosphorylated on serine 181 by PKC theta or cGMP dependent protein kinase 2 (PRKG2) (Bivona et al, 2006; Alvarez-Moya et al, 2010; Cho et al, 2016; reviewed in Ahearn et al, 2018). Serine 181 lies in a polybasic region unique to KRAS upstream of the CaaX motif. Phosphorylation at this position decreases the affinity of KRAS4B for the membrane and promotes internalization (Bivona et al, 2006; Barcelo et al, 2013; Jang et al, 2015). S181 phosphorylation has been shown to restrict cellular proliferation and oncogenesis in part by promoting BCL2L (also known as BCL-XL)-dependent apoptosis (Bivona et al, 2006; Mohammad et al, 1998; Kollar et al, 2014). Phosphorylation at S181 may also interfere with the binding of calmodulin to KRAS4B, thus disrupting calmodulin-dependent supression of signaling downstream of RAS (Wang et al, 2001; Villalonga et al, 2001).", "className": "Summation", "schemaClass": "Summation"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "isChimeric": false, "category": "transition", "catalystActivity": [{"dbId": 9653502, "displayName": "protein serine/threonine kinase activity of PKCZ,PRKG2 [plasma membrane]", "catalyzedEvent": [9653503], "physicalEntity": {"dbId": 9653487, "displayName": "PKCZ,PRKG2 [plasma membrane]", "stId": "R-HSA-9653487", "stIdVersion": "R-HSA-9653487.2", "maxDepth": 4, "name": ["PKCZ,PRKG2"], "speciesName": "Homo sapiens", "catalystActivities": [9653502], "className": "Set", "inDisease": false, "schemaClass": "DefinedSet"}, "className": "CatalystActivity", "schemaClass": "CatalystActivity"}], "input": [{"dbId": 113592, "displayName": "ATP [cytosol]", "stId": "R-ALL-113592", "stIdVersion": "R-ALL-113592.5", "maxDepth": 1, "name": ["ATP", "Adenosine 5'-triphosphate", "ATP(4-)"], "crossReference": [{"dbId": 29359, "displayName": "COMPOUND:C00002", "databaseName": "COMPOUND", "identifier": "C00002", "url": "https://www.kegg.jp/entry/C00002", "className": "DatabaseIdentifier", "schemaClass"