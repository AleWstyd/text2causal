xId": "10090", "abbreviation": "MMU", "className": "Species", "schemaClass": "Species"}], "category": "binding", "className": "Reaction", "schemaClass": "Reaction"}], "reviewed": [{"dbId": 4410473, "displayName": "Bruinsma, Wytse, 2013-08-21", "dateTime": "2013-08-21 04:00:00", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}, {"dbId": 9936318, "displayName": "Alwakeel, Alan, 2025-01-02", "dateTime": "2025-01-02 00:00:00", "className": "InstanceEdit", "schemaClass": "InstanceEdit"}], "species": [48887], "summation": [{"dbId": 3002850, "displayName": "BORA is able to interact with both AURKA (Aurora A kinase) a...", "text": "BORA is able to interact with both AURKA (Aurora A kinase) and PLK1. Binding of BORA to PLK1 increases the accessibility of PLK1 threonine residue T210 and also brings PLK1 in proximity to AURKA, enabling AURKA to phosphorylate T210 of PLK1 and thereby activate PLK1 (Seki et al. 2008). While BORA is required for mitotic activation of AURKA in Drosophila (Hutterer et al. 2006), it does not significantly activate AURKA in human cells (Seki et al. 2008). AURKA is able to phosphorylate BORA in vitro, but the functional significance of this modification has not been determined (Hutterer et al. 2006).", "className": "Summation", "schemaClass": "Summation"}], "negativePrecedingEvent": [{"dbId": 9764016, "displayName": "Futile Cycle: AURKA phosphorylates PLK1", "precedingEvent": [3000319], "className": "NegativePrecedingEvent", "schemaClass": "NegativePrecedingEvent"}], "reviewStatus": {"dbId": 9821382, "displayName": "five stars", "definition": "externally reviewed", "name": ["five stars"], "className": "ReviewStatus", "schemaClass": "ReviewStatus"}, "isChimeric": false, "category": "binding", "input": [{"dbId": 164603, "displayName": "PLK1 [cytosol]", "stId": "R-HSA-164603", "stIdVersion": "R-HSA-164603.1", "maxDepth": 1, "name": ["PLK1"], "speciesName": "Homo sapiens", "consumedByEvent": [3000319], "species": 48887, "endCoordinate": 603, "r